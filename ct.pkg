# rill - RILL 语言实现的 CT 源码包。
#
# 包根是仓库根；CT 单元在 `ct/src` 下（`main.ct` 为入口，其余按
# `common::common`、`loader::loader` 这类命名空间导入），因此 ns-root 取
# `ct/src`，与 `ct/build.sh` 的 `-I src` 一致。
#
# publisher 与 ns-root 是 ct-pkg 共享库契约要求的两个身份键；同一包的
# 所有版本必须保持同一 publisher，确定后不再修改。
name = rill
publisher = ct
ns-root = ct/src
version = 0.23.1
requires = ct >= 0.65.1
