{
  "name": "rill-dsl",
  "displayName": "RILL DSL",
  "description": "RILL 0.1.x 语法高亮，以及函数定义/调用点的跨文件跳转",
  "version": "0.1.3",
  "publisher": "rill-lang",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "rill",
    "dsl",
    "syntax",
    "definition"
  ],
  "activationEvents": [
    "onLanguage:rill",
    "workspaceContains:**/*.ri"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rill",
        "aliases": [
          "RILL",
          "rill"
        ],
        "extensions": [
          ".ri"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rill",
        "scopeName": "source.rill",
        "path": "./syntaxes/rill.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "comment.line.double-slash.rill",
              "comment.block.map.rill"
            ],
            "settings": {
              "foreground": "#8B949E"
            }
          },
          {
            "scope": [
              "variable.other.rill",
              "variable.other.identifier.rill",
              "variable.language.self.rill"
            ],
            "settings": {
              "foreground": "#2A9D8F"
            }
          },
          {
            "scope": "entity.name.function.verb.rill",
            "settings": {
              "foreground": "#3B82F6",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "support.type.preposition.rill",
            "settings": {
              "foreground": "#BA68C8"
            }
          },
          {
            "scope": "keyword.control.block-marker.rill",
            "settings": {
              "foreground": "#EA580C",
              "fontStyle": "bold"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "test": "bash test/run-tests.sh",
    "package": "python3 tools/package_vsix.py",
    "check:vsix": "python3 tools/package_vsix.py --check dist/rill-dsl-0.1.3.vsix"
  }
}
