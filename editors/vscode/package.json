{
  "name": "rill-dsl",
  "displayName": "RILL DSL",
  "description": "RILL 0.1.x 语法高亮，以及函数定义/调用点的跨文件跳转",
  "version": "0.1.1",
  "publisher": "rill-lang",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "rill",
    "dsl",
    "syntax",
    "definition"
  ],
  "activationEvents": [
    "onLanguage:rill",
    "workspaceContains:**/*.ri"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "rill",
        "aliases": [
          "RILL",
          "rill"
        ],
        "extensions": [
          ".ri"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rill",
        "scopeName": "source.ri",
        "path": "./syntaxes/rill.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "bash test/run-tests.sh",
    "package": "python3 tools/package_vsix.py",
    "check:vsix": "python3 tools/package_vsix.py --check dist/rill-dsl-0.1.1.vsix"
  }
}
