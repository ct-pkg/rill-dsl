{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RILL",
  "scopeName": "source.ri",
  "fileTypes": [
    "ri"
  ],
  "patterns": [
    {
      "include": "#map-block"
    },
    {
      "include": "#fn-block"
    },
    {
      "include": "#common"
    }
  ],
  "repository": {
    "common": [
      {
        "include": "#comment"
      },
      {
        "include": "#map-reference"
      },
      {
        "include": "#strings"
      },
      {
        "include": "#function-call"
      },
      {
        "include": "#verbs"
      },
      {
        "include": "#prepositions"
      },
      {
        "include": "#variables"
      },
      {
        "include": "#fields"
      },
      {
        "include": "#numbers"
      },
      {
        "include": "#keywords"
      },
      {
        "include": "#operators"
      },
      {
        "include": "#punctuation"
      }
    ],
    "map-block": {
      "name": "meta.block.map.ri",
      "begin": "//[ \\t]*map[ \\t]*\\{",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.block-header.ri"
        }
      },
      "end": "^[ \\t]*\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.ri"
        }
      },
      "patterns": [
        {
          "match": "^[ \\t]*([A-Za-z0-9_-]+)(['`<])(.*)$",
          "captures": {
            "1": {
              "name": "variable.other.mapping-key.ri"
            },
            "2": {
              "name": "keyword.operator.mapping-marker.ri"
            },
            "3": {
              "name": "string.unquoted.mapping-value.ri"
            }
          }
        }
      ]
    },
    "fn-block": {
      "name": "meta.block.fn.ri",
      "begin": "//[ \\t]*fn[ \\t]*\\{",
      "beginCaptures": {
        "0": {
          "name": "keyword.control.block-header.ri"
        }
      },
      "end": "^\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.ri"
        }
      },
      "patterns": [
        {
          "include": "#fn-definition"
        },
        {
          "include": "#common"
        }
      ]
    },
    "fn-definition": {
      "name": "meta.function.definition.ri",
      "match": "(@)([ \\t]*)(\"(?:[^\"\\\\\\n]|\\\\.)*\"|'[^'\\n]*')",
      "captures": {
        "1": {
          "name": "keyword.operator.function.ri"
        },
        "3": {
          "name": "entity.name.function.definition.ri"
        }
      }
    },
    "function-call": {
      "name": "meta.function.call.ri",
      "match": "(@)([ \\t]*)(\"(?:[^\"\\\\\\n]|\\\\.)*\"|'[^'\\n]*')",
      "captures": {
        "1": {
          "name": "keyword.operator.function.ri"
        },
        "3": {
          "name": "entity.name.function.call.ri"
        }
      }
    },
    "comment": {
      "name": "comment.line.double-slash.ri",
      "match": "//.*"
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ri",
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\""
        },
        {
          "name": "string.quoted.single.ri",
          "match": "'[^'\\n]*'"
        }
      ]
    },
    "map-reference": {
      "name": "string.quoted.other.mapping-reference.ri",
      "match": "`[^`\\n]+`"
    },
    "verbs": {
      "name": "meta.verb.ri",
      "match": "(<)([^>\\n]*)(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.verb.begin.ri"
        },
        "2": {
          "name": "entity.name.function.verb.ri"
        },
        "3": {
          "name": "punctuation.definition.verb.end.ri"
        }
      }
    },
    "prepositions": {
      "match": "(\\[)(to|with|from|in|on|into|ok|error|results)(\\])",
      "captures": {
        "1": {
          "name": "punctuation.definition.preposition.begin.ri"
        },
        "2": {
          "name": "support.type.preposition.ri"
        },
        "3": {
          "name": "punctuation.definition.preposition.end.ri"
        }
      }
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.ri",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "variable.language.self.ri",
          "match": "\\$(?![A-Za-z0-9_])"
        }
      ]
    },
    "fields": {
      "name": "variable.other.property.ri",
      "match": "(?<![\\w\\-.:'\"`])\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    "numbers": {
      "name": "constant.numeric.ri",
      "match": "(?<![\\w\\-.:'\"`])-?[0-9]+\\b"
    },
    "keywords": {
      "name": "keyword.control.ri",
      "match": "(?<![\\w-])(?:else-if|else|if|each|parallel|break)(?![\\w-])"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.ri",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.assignment.ri",
          "match": "->"
        },
        {
          "name": "keyword.operator.default.ri",
          "match": "\\?"
        },
        {
          "name": "punctuation.separator.comma.ri",
          "match": ","
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.braces.ri",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.ri",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.ri",
          "match": "[()]"
        },
        {
          "name": "keyword.operator.function.ri",
          "match": "@"
        }
      ]
    }
  }
}
