// host::exec — 子进程执行（PH-20 抽出，Shell 进程能力与 Agent 工具 transport 共用）
//
// 只做 spawn / cwd / stdin / 同时捕获 stdout+stderr / 超时；不解释结果。
// errno 用平台访问器：ct 前端不展开 <errno.h> 的宏（见 workarounds PH-19 §6）。

#include "bridge.h"

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <signal.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <time.h>

#define HOST_EXEC_CHUNK 4096
#define HOST_EXEC_TOKEN_MAX 4096

pub struct ExecResult {
    int have_code;
    int code;
    int pid;
    int timed_out;
    char *stdout_data;
    int stdout_len;
    char *stderr_data;
    int stderr_len;
    const char *spawn_error;
};

pub int host_errno(void)
{
    return (*__error());
}

typedef struct {
    char *data;
    int len;
    int cap;
} ExBuf;

static void ex_buf_put(ExBuf *b, const char *data, int n)
{
    if (b->len + n + 1 > b->cap) {
        int cap = b->cap ? b->cap : 256;
        while (cap < b->len + n + 1) cap *= 2;
        b->data = (char *)xrealloc(b->data, (size_t)cap);
        b->cap = cap;
    }
    if (n > 0) memcpy(b->data + b->len, data, (size_t)n);
    b->len += n;
    b->data[b->len] = 0;
}

static void ex_buf_drain(int fd, ExBuf *b)
{
    char chunk[HOST_EXEC_CHUNK];
    for (;;) {
        ssize_t got = read(fd, chunk, sizeof(chunk));
        if (got > 0) {
            ex_buf_put(b, chunk, (int)got);
            continue;
        }
        if (got < 0 && host_errno() == EINTR) continue;
        break;
    }
}

static long ex_now_ms(void)
{
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (long)ts.tv_sec * 1000L + (long)(ts.tv_nsec / 1000000L);
}

static void ex_tok_add(char **tok, int *len, int *cap, char c)
{
    if (*len + 1 >= *cap) {
        *cap *= 2;
        *tok = (char *)xrealloc(*tok, (size_t)*cap);
    }
    (*tok)[(*len)++] = c;
}

static void ex_push_arg(char ***argv, int *argc, int *cap, const char *tok, int len)
{
    if (*argc + 1 >= *cap) {
        *cap *= 2;
        *argv = (char **)xrealloc(*argv, sizeof(char *) * (size_t)*cap);
    }
    (*argv)[*argc] = xstrndup(tok, len);
    (*argc)++;
}

/* shlex.split 的 POSIX 子集：单引号字面、双引号可转义、反斜杠转义。 */
pub char **host_split(const char *command, int *out_argc)
{
    int cap = 8;
    int argc = 0;
    int tcap = 32;
    int tlen = 0;
    int have = 0;
    int quote = 0;
    int i;
    char *tok = (char *)xmalloc((size_t)tcap);
    char **argv = (char **)xmalloc(sizeof(char *) * (size_t)cap);

    for (i = 0; ; i++) {
        char c = command[i];
        if (c == 0) {
            if (have) ex_push_arg(&argv, &argc, &cap, tok, tlen);
            break;
        }
        if (quote == 0) {
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                if (have) {
                    ex_push_arg(&argv, &argc, &cap, tok, tlen);
                    tlen = 0;
                    have = 0;
                }
                continue;
            }
            if (c == '\'') {
                quote = '\'';
                have = 1;
                continue;
            }
            if (c == '"') {
                quote = '"';
                have = 1;
                continue;
            }
            if (c == '\\' && command[i + 1] != 0) {
                i++;
                ex_tok_add(&tok, &tlen, &tcap, command[i]);
                have = 1;
                continue;
            }
            ex_tok_add(&tok, &tlen, &tcap, c);
            have = 1;
        } else if (quote == '\'') {
            if (c == '\'') {
                quote = 0;
                continue;
            }
            ex_tok_add(&tok, &tlen, &tcap, c);
        } else {
            if (c == '"') {
                quote = 0;
                continue;
            }
            if (c == '\\' && command[i + 1] != 0) {
                i++;
                ex_tok_add(&tok, &tlen, &tcap, command[i]);
                continue;
            }
            ex_tok_add(&tok, &tlen, &tcap, c);
        }
    }
    argv[argc] = 0;
    *out_argc = argc;
    free(tok);
    return argv;
}

pub int host_can_exec(const char *cmd)
{
    char candidate[HOST_EXEC_TOKEN_MAX];
    const char *path;
    const char *at;
    if (strchr(cmd, '/') != 0) return access(cmd, X_OK) == 0;
    path = getenv("PATH");
    if (path == 0) path = "/usr/bin:/bin";
    at = path;
    for (;;) {
        const char *colon = strchr(at, ':');
        int len = colon != 0 ? (int)(colon - at) : (int)strlen(at);
        if (len == 0) {
            snprintf(candidate, sizeof(candidate), "%s", cmd);
        } else {
            snprintf(candidate, sizeof(candidate), "%.*s/%s", len, at, cmd);
        }
        if (access(candidate, X_OK) == 0) return 1;
        if (colon == 0) break;
        at = colon + 1;
    }
    return 0;
}

/*
 * 执行 argv；stdin 可为二进制，stdout/stderr 同时捕获。
 * 结果里的 data 由 malloc 持有，调用方只读。
 */
pub void host_exec_argv(char **argv, int argc, const char *cwd, const char *in,
                        int in_len, int timeout_ms, ExecResult *r)
{
    int in_pipe[2] = {-1, -1};
    int out_pipe[2] = {-1, -1};
    int err_pipe[2] = {-1, -1};
    ExBuf outbuf;
    ExBuf errbuf;
    int in_off = 0;
    int in_open = 0;
    int out_open = 0;
    int err_open = 0;
    int status = 0;
    long deadline;
    pid_t pid;

    memset(r, 0, sizeof(*r));
    memset(&outbuf, 0, sizeof(outbuf));
    memset(&errbuf, 0, sizeof(errbuf));
    signal(SIGPIPE, SIG_IGN);

    if (argc == 0) {
        r->spawn_error = "进程命令为空";
        return;
    }
    if (!host_can_exec(argv[0])) {
        char *msg = (char *)xmalloc(strlen(argv[0]) + 64);
        sprintf(msg, "[Errno 2] No such file or directory: '%s'", argv[0]);
        r->spawn_error = msg;
        return;
    }
    if (pipe(in_pipe) != 0 || pipe(out_pipe) != 0 || pipe(err_pipe) != 0) {
        r->spawn_error = "无法创建管道";
        return;
    }
    pid = fork();
    if (pid < 0) {
        r->spawn_error = "无法创建进程";
        return;
    }
    if (pid == 0) {
        dup2(in_pipe[0], 0);
        dup2(out_pipe[1], 1);
        dup2(err_pipe[1], 2);
        close(in_pipe[0]);
        close(in_pipe[1]);
        close(out_pipe[0]);
        close(out_pipe[1]);
        close(err_pipe[0]);
        close(err_pipe[1]);
        if (cwd != 0 && chdir(cwd) != 0) _exit(127);
        execvp(argv[0], argv);
        _exit(127);
    }

    close(in_pipe[0]);
    close(out_pipe[1]);
    close(err_pipe[1]);
    r->pid = (int)pid;
    fcntl(out_pipe[0], F_SETFL, O_NONBLOCK);
    fcntl(err_pipe[0], F_SETFL, O_NONBLOCK);
    in_open = 1;
    if (in_len == 0) {
        close(in_pipe[1]);
        in_open = 0;
    }
    out_open = 1;
    err_open = 1;
    deadline = ex_now_ms() + timeout_ms;
    while (out_open || err_open || in_open) {
        int progress = 0;
        char chunk[HOST_EXEC_CHUNK];
        ssize_t got;
        if (out_open) {
            got = read(out_pipe[0], chunk, sizeof(chunk));
            if (got > 0) {
                ex_buf_put(&outbuf, chunk, (int)got);
                progress = 1;
            } else if (got == 0) {
                out_open = 0;
                progress = 1;
            } else if (host_errno() != EAGAIN && host_errno() != EWOULDBLOCK &&
                       host_errno() != EINTR) {
                out_open = 0;
                progress = 1;
            }
        }
        if (err_open) {
            got = read(err_pipe[0], chunk, sizeof(chunk));
            if (got > 0) {
                ex_buf_put(&errbuf, chunk, (int)got);
                progress = 1;
            } else if (got == 0) {
                err_open = 0;
                progress = 1;
            } else if (host_errno() != EAGAIN && host_errno() != EWOULDBLOCK &&
                       host_errno() != EINTR) {
                err_open = 0;
                progress = 1;
            }
        }
        if (in_open) {
            ssize_t put = write(in_pipe[1], in + in_off,
                                (size_t)(in_len - in_off));
            if (put > 0) {
                in_off += (int)put;
                progress = 1;
                if (in_off >= in_len) {
                    close(in_pipe[1]);
                    in_open = 0;
                }
            } else if (put < 0 && host_errno() != EAGAIN &&
                       host_errno() != EWOULDBLOCK &&
                       host_errno() != EINTR) {
                close(in_pipe[1]);
                in_open = 0;
                progress = 1;
            }
        }
        if (!out_open && !err_open && !in_open) break;
        if (ex_now_ms() >= deadline) {
            r->timed_out = 1;
            kill(pid, SIGKILL);
            break;
        }
        if (!progress) usleep(1000);
    }
    if (in_open) close(in_pipe[1]);
    waitpid(pid, &status, 0);
    ex_buf_drain(out_pipe[0], &outbuf);
    ex_buf_drain(err_pipe[0], &errbuf);
    close(out_pipe[0]);
    close(err_pipe[0]);

    r->stdout_data = outbuf.data != 0 ? outbuf.data : xstrdup("");
    r->stdout_len = outbuf.len;
    r->stderr_data = errbuf.data != 0 ? errbuf.data : xstrdup("");
    r->stderr_len = errbuf.len;
    if (!r->timed_out) {
        r->have_code = 1;
        if (WIFEXITED(status)) r->code = WEXITSTATUS(status);
        else if (WIFSIGNALED(status)) r->code = -WTERMSIG(status);
        else r->have_code = 0;
    }
}

pub void host_exec(const char *command, const char *cwd, const char *in,
                   int in_len, int timeout_ms, ExecResult *r)
{
    int argc = 0;
    char **argv = host_split(command, &argc);
    host_exec_argv(argv, argc, cwd, in, in_len, timeout_ms, r);
}
