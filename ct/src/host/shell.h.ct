// shell — Shell 宿主能力（PH-19）：进程 / 文件 / env / stdio / 退出码
//
// 卡面原计划把实现放 shell.m.ct，但 `ct build` 的映射单元不能定义函数
// （实测 `a .m.ct unit cannot define a function`），故实现与声明同在本单元；
// 偏差已报，判据不动。能力派发经 host::host 的函数指针表，绕开 PH-51。

#include "bridge.h"

import host::host;

import host::exec;

import json::json;

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <errno.h>

#define SH_PROFILE_MAX 128
#define SH_PROFILE_SCHEMA "rill.shell-profile/0"
#define SH_TIMEOUT_MS 10000
#define SH_TOKEN_MAX 4096

/* ct 前端不展开 <errno.h> 的 errno 宏（实测 `use of an undeclared variable`）；
   访问器收在 host::exec。见 workarounds 的 PH-19 条目。 */

pub struct ShellHost {
    char profile[128];
    char *cwd;
    HostOps *ops;
    int proc_run;
    int fs_read;
    int fs_write;
    int env_get;
    int stdio_write;
    int exit_ok;
    int exit_unhandled;
};

/* ------------------------------------------------------------------ */
/* policy                                                              */
/* ------------------------------------------------------------------ */

static char *sh_cwd(void)
{
    char *cwd = getcwd(0, 0);
    return cwd != 0 ? cwd : xstrdup(".");
}

static void sh_profile_fail(const char *path, const char *fmt, ...)
{
    char msg[512];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(msg, sizeof(msg), fmt, ap);
    va_end(ap);
    (void)path;
    fail("run", "E-RUN-HOST-PROFILE", 0, 0, "%s", msg);
}

static int sh_slot_allowed(const char *name)
{
    return strcmp(name, "process") == 0 || strcmp(name, "fs") == 0 ||
           strcmp(name, "env") == 0 || strcmp(name, "stdio") == 0;
}

static int sh_profile_field_allowed(const char *name)
{
    return strcmp(name, "schema") == 0 || strcmp(name, "name") == 0 ||
           strcmp(name, "description") == 0 || strcmp(name, "allow") == 0 ||
           strcmp(name, "exit_codes") == 0;
}

static int sh_list_has(JVal *list, const char *needle)
{
    int i;
    if (list == 0 || list->kind != J_ARR) return 0;
    for (i = 0; i < list->len; i++) {
        JVal *item = list->items[i];
        if (item->kind == J_STR && strcmp(item->str, needle) == 0) return 1;
    }
    return 0;
}

static void sh_slot_validate(const char *path, JVal *allow, const char *slot)
{
    JVal *list = jget(allow, slot);
    int i;
    if (list == 0) return;
    if (list->kind != J_ARR) {
        sh_profile_fail(path, "%s.allow.%s: 必须是非空字符串数组", path, slot);
    }
    for (i = 0; i < list->len; i++) {
        JVal *item = list->items[i];
        if (item->kind != J_STR || item->str[0] == 0) {
            sh_profile_fail(path, "%s.allow.%s: 必须是非空字符串数组", path, slot);
        }
    }
}

static ShellHost *sh_alloc(void)
{
    ShellHost *h = (ShellHost *)xmalloc(sizeof(ShellHost));
    memset(h, 0, sizeof(*h));
    h->cwd = sh_cwd();
    h->exit_ok = 0;
    h->exit_unhandled = 1;
    return h;
}

/* shell profile 的默认能力：只读文件、读 env、写 stdio；不起进程、不写文件。 */
pub ShellHost *sh_default_host(void)
{
    ShellHost *h = sh_alloc();
    snprintf(h->profile, SH_PROFILE_MAX, "%s", "builtin-shell");
    h->fs_read = 1;
    h->env_get = 1;
    h->stdio_write = 1;
    return h;
}

pub ShellHost *sh_load_host(const char *path)
{
    ShellHost *h = sh_alloc();
    int n = 0;
    int pos = 0;
    char *text = read_source(path, &n);
    JVal *doc;
    JVal *allow;
    JVal *codes;
    JVal *name;
    JVal *schema;
    int i;

    (void)n;
    if (text == 0) {
        int err = host_errno();
        char detail[512];
        snprintf(detail, sizeof(detail), "[Errno %d] %s: '%s'", err,
                 strerror(err), path);
        sh_profile_fail(path, "%s: 无法读取能力清单（%s）", path, detail);
    }
    doc = json_parse(text, &pos);
    if (doc == 0 || doc->kind != J_OBJ) {
        sh_profile_fail(path, "%s: 顶层必须是对象", path);
    }
    for (i = 0; i < doc->len; i++) {
        if (!sh_profile_field_allowed(doc->keys[i])) {
            sh_profile_fail(path, "%s: 未知字段 '%s'", path, doc->keys[i]);
        }
    }
    schema = jget(doc, "schema");
    if (schema == 0 || schema->kind != J_STR ||
        strcmp(schema->str, SH_PROFILE_SCHEMA) != 0) {
        sh_profile_fail(path, "%s.schema: 必须是 %s", path, SH_PROFILE_SCHEMA);
    }
    name = jget(doc, "name");
    if (name == 0 || name->kind != J_STR || name->str[0] == 0) {
        sh_profile_fail(path, "%s.name: 必须是非空字符串", path);
    }
    allow = jget(doc, "allow");
    if (allow == 0 || allow->kind != J_OBJ) {
        sh_profile_fail(path, "%s.allow: 必须是对象", path);
    }
    for (i = 0; i < allow->len; i++) {
        if (!sh_slot_allowed(allow->keys[i])) {
            sh_profile_fail(path, "%s.allow: 未知槽位 '%s'", path, allow->keys[i]);
        }
    }
    sh_slot_validate(path, allow, "process");
    sh_slot_validate(path, allow, "fs");
    sh_slot_validate(path, allow, "env");
    sh_slot_validate(path, allow, "stdio");
    h->proc_run = sh_list_has(jget(allow, "process"), "run");
    h->fs_read = sh_list_has(jget(allow, "fs"), "read");
    h->fs_write = sh_list_has(jget(allow, "fs"), "write");
    h->env_get = sh_list_has(jget(allow, "env"), "get");
    h->stdio_write = sh_list_has(jget(allow, "stdio"), "write");

    codes = jget(doc, "exit_codes");
    if (codes != 0 && codes->kind != J_NULL) {
        if (codes->kind != J_OBJ) {
            sh_profile_fail(path, "%s.exit_codes: 必须是对象", path);
        }
        for (i = 0; i < codes->len; i++) {
            const char *key = codes->keys[i];
            JVal *value = codes->items[i];
            if (strcmp(key, "ok") != 0 && strcmp(key, "unhandled") != 0) {
                sh_profile_fail(path, "%s.exit_codes: 未知字段 '%s'", path, key);
            }
            if (value->kind != J_INT) {
                sh_profile_fail(path, "%s.exit_codes.%s: 必须是整数", path, key);
            }
            if (strcmp(key, "ok") == 0) h->exit_ok = (int)value->num;
            else h->exit_unhandled = (int)value->num;
        }
    }
    snprintf(h->profile, SH_PROFILE_MAX, "%s", name->str);
    return h;
}

pub int sh_exit_code(ShellHost *h, int ok)
{
    return ok ? h->exit_ok : h->exit_unhandled;
}

/* 能力清单未声明该操作：与 Python 一样走 run 诊断（exit 2），不是 ok=false。 */
static void sh_require(ShellHost *h, const char *slot, const char *op, int allowed)
{
    char msg[512];
    if (allowed) return;
    snprintf(msg, sizeof(msg),
             "E-HOST-CAPABILITY-DENIED: Shell profile '%s' 未声明能力 %s.%s；"
             "在 --host-profile 的 allow.%s 中加入 '%s'",
             h->profile, slot, op, slot, op);
    fail("run", "E-HOST-CAPABILITY-DENIED", 0, 0, "%s", msg);
}

/* ------------------------------------------------------------------ */
/* bytes                                                               */
/* ------------------------------------------------------------------ */

static int sh_utf8_valid(const unsigned char *s, int n)
{
    int i = 0;
    while (i < n) {
        unsigned char c = s[i];
        unsigned int cp;
        int need;
        int k;
        if (c == 0) return 0;
        if (c < 0x80) {
            i++;
            continue;
        }
        if ((c & 0xE0) == 0xC0) {
            need = 1;
            cp = c & 0x1F;
            if (cp < 2) return 0;
        } else if ((c & 0xF0) == 0xE0) {
            need = 2;
            cp = c & 0x0F;
        } else if ((c & 0xF8) == 0xF0) {
            need = 3;
            cp = c & 0x07;
        } else {
            return 0;
        }
        if (i + need >= n) return 0;
        for (k = 1; k <= need; k++) {
            unsigned char cc = s[i + k];
            if ((cc & 0xC0) != 0x80) return 0;
            cp = (cp << 6) | (cc & 0x3F);
        }
        if (need == 2 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) {
            return 0;
        }
        if (need == 3 && (cp < 0x10000 || cp > 0x10FFFF)) return 0;
        i += need + 1;
    }
    return 1;
}

/* UTF-8 文本优先；非法 UTF-8 保留为 Bytes，不做有损替换。 */
static JVal *sh_decode(const char *data, int n)
{
    if (sh_utf8_valid((const unsigned char *)data, n)) return jstrn(data, n);
    return jbytes(data, n);
}

/* ------------------------------------------------------------------ */
/* fs / env                                                            */
/* ------------------------------------------------------------------ */

static char *sh_resolve(ShellHost *h, const char *path)
{
    size_t n;
    char *resolved;
    if (path[0] == '/') return xstrdup(path);
    n = strlen(h->cwd) + strlen(path) + 2;
    resolved = (char *)xmalloc(n);
    snprintf(resolved, n, "%s/%s", h->cwd, path);
    return resolved;
}

/* 与 Python 的 ``"%s（%s）" % (path, OSError)`` 同形。 */
static const char *sh_os_error(const char *code, const char *path,
                               const char *resolved, int err)
{
    char detail[1024];
    char *message;
    size_t n;
    snprintf(detail, sizeof(detail), "[Errno %d] %s: '%s'", err,
             strerror(err), resolved);
    n = strlen(path) + strlen(detail) + 8;
    message = (char *)xmalloc(n);
    snprintf(message, n, "%s（%s）", path, detail);
    return host_error_text(code, message);
}

static HRes sh_fs_read(void *ctx, const char *path)
{
    ShellHost *h = (ShellHost *)ctx;
    HRes r;
    char *target;
    FILE *f;
    long size;
    char *raw;
    int n;

    sh_require(h, "fs", "read", h->fs_read);
    target = sh_resolve(h, path);
    f = fopen(target, "rb");
    if (f == 0) {
        int err = host_errno();
        hres_failure(&r, sh_os_error("E-HOST-FS-READ", path, target, err),
                     host_error_meta("E-HOST-FS-READ"));
        return r;
    }
    if (fseek(f, 0, SEEK_END) != 0 || (size = ftell(f)) < 0 ||
        fseek(f, 0, SEEK_SET) != 0) {
        int err = host_errno();
        fclose(f);
        hres_failure(&r, sh_os_error("E-HOST-FS-READ", path, target, err),
                     host_error_meta("E-HOST-FS-READ"));
        return r;
    }
    raw = (char *)xmalloc((size_t)size + 1);
    n = (int)fread(raw, 1, (size_t)size, f);
    fclose(f);
    raw[n] = 0;
    hres_success(&r, sh_decode(raw, n));
    return r;
}

static HRes sh_fs_write(void *ctx, const char *path, JVal *content)
{
    ShellHost *h = (ShellHost *)ctx;
    HRes r;
    char *target;
    FILE *f;
    const char *raw;
    int n;
    JVal *meta;

    sh_require(h, "fs", "write", h->fs_write);
    raw = content->str;
    n = content->kind == J_BYTES ? (int)content->num : (int)strlen(content->str);
    target = sh_resolve(h, path);
    f = fopen(target, "wb");
    if (f == 0) {
        int err = host_errno();
        hres_failure(&r, sh_os_error("E-HOST-FS-WRITE", path, target, err),
                     host_error_meta("E-HOST-FS-WRITE"));
        return r;
    }
    if (n > 0 && fwrite(raw, 1, (size_t)n, f) != (size_t)n) {
        int err = host_errno();
        fclose(f);
        hres_failure(&r, sh_os_error("E-HOST-FS-WRITE", path, target, err),
                     host_error_meta("E-HOST-FS-WRITE"));
        return r;
    }
    fclose(f);
    meta = jobj();
    jput(meta, "path", jstr(path));
    hres_success(&r, jstr(path));
    r.meta = jobj();
    jput(r.meta, "fs", meta);
    return r;
}

static HRes sh_env_get(void *ctx, const char *name)
{
    ShellHost *h = (ShellHost *)ctx;
    HRes r;
    const char *value;
    char detail[512];

    sh_require(h, "env", "get", h->env_get);
    value = getenv(name);
    if (value == 0) {
        snprintf(detail, sizeof(detail), "环境变量 '%s' 未定义", name);
        hres_failure(&r, host_error_text("E-HOST-ENV-MISSING", detail),
                     host_error_meta("E-HOST-ENV-MISSING"));
        return r;
    }
    hres_success(&r, jstr(value));
    return r;
}

/* ------------------------------------------------------------------ */
/* stdio                                                               */
/* ------------------------------------------------------------------ */

static char *sh_text_of(JVal *v)
{
    if (v == 0 || v->kind == J_NULL) return xstrdup("");
    if (v->kind == J_STR) return xstrdup(v->str);
    if (v->kind == J_BYTES) return jbytes_text(v);
    return json_text(v);
}

static HRes sh_stdio_write(void *ctx, JVal *value)
{
    ShellHost *h = (ShellHost *)ctx;
    HRes r;
    char *text;
    JVal *info;
    JVal *meta;

    sh_require(h, "stdio", "write", h->stdio_write);
    text = sh_text_of(value);
    fputs(text, stderr);
    fputc('\n', stderr);
    fflush(stderr);
    info = jobj();
    jput(info, "channel", jstr("stderr"));
    jput(info, "text", jstr(text));
    meta = jobj();
    jput(meta, "stdio", info);
    hres_success(&r, jstr(text));
    r.meta = meta;
    return r;
}

/* ------------------------------------------------------------------ */
/* process                                                             */
/* ------------------------------------------------------------------ */

typedef struct {
    char *data;
    int len;
    int cap;
} ShBuf;

static void sh_buf_put(ShBuf *b, const char *data, int n)
{
    if (b->len + n + 1 > b->cap) {
        int cap = b->cap ? b->cap : 256;
        while (cap < b->len + n + 1) cap *= 2;
        b->data = (char *)xrealloc(b->data, (size_t)cap);
        b->cap = cap;
    }
    if (n > 0) memcpy(b->data + b->len, data, (size_t)n);
    b->len += n;
    b->data[b->len] = 0;
}

static JVal *sh_argv_json(char **argv, int argc)
{
    JVal *list = jarr();
    int i;
    for (i = 0; i < argc; i++) jpush(list, jstr(argv[i]));
    return list;
}

/* Python ``%r`` 对 list[str] 的常见形态。 */
static const char *sh_argv_repr(char **argv, int argc)
{
    int i;
    ShBuf b;
    memset(&b, 0, sizeof(b));
    sh_buf_put(&b, "[", 1);
    for (i = 0; i < argc; i++) {
        if (i > 0) sh_buf_put(&b, ", ", 2);
        sh_buf_put(&b, "'", 1);
        sh_buf_put(&b, argv[i], (int)strlen(argv[i]));
        sh_buf_put(&b, "'", 1);
    }
    sh_buf_put(&b, "]", 1);
    return b.data;
}

static HRes sh_process_run(void *ctx, const char *command, JVal *stdin_value)
{
    ShellHost *h = (ShellHost *)ctx;
    HRes r;
    int argc = 0;
    char **argv;
    ExecResult er;
    const char *raw_in = 0;
    int in_len = 0;
    JVal *meta;
    JVal *stdoutv;
    JVal *stderrv;

    sh_require(h, "process", "run", h->proc_run);
    argv = host_split(command, &argc);
    if (stdin_value != 0 && stdin_value->kind == J_STR) {
        raw_in = stdin_value->str;
        in_len = (int)strlen(stdin_value->str);
    } else if (stdin_value != 0 && stdin_value->kind == J_BYTES) {
        raw_in = stdin_value->str;
        in_len = (int)stdin_value->num;
    }
    host_exec_argv(argv, argc, h->cwd, raw_in, in_len, SH_TIMEOUT_MS, &er);

    stdoutv = sh_decode(er.stdout_data != 0 ? er.stdout_data : "",
                        er.stdout_len);
    stderrv = sh_decode(er.stderr_data != 0 ? er.stderr_data : "",
                        er.stderr_len);
    meta = jobj();
    {
        JVal *inner = jobj();
        jput(inner, "argv", sh_argv_json(argv, argc));
        jput(inner, "code", er.have_code ? jint(er.code) : jnull());
        jput(inner, "stdout", stdoutv);
        jput(inner, "stderr", stderrv);
        jput(inner, "timed_out", jbool(er.timed_out));
        jput(meta, "process", inner);
    }
    if (er.timed_out) {
        const char *prefix = "E-HOST-PROCESS-TIMEOUT: 进程超时（argv=";
        const char *repr = sh_argv_repr(argv, argc);
        ShBuf tmsg;
        memset(&tmsg, 0, sizeof(tmsg));
        sh_buf_put(&tmsg, prefix, (int)strlen(prefix));
        sh_buf_put(&tmsg, repr, (int)strlen(repr));
        sh_buf_put(&tmsg, "）", (int)strlen("）"));
        hres_failure(&r, tmsg.data, meta);
        return r;
    }
    if (er.spawn_error != 0) {
        hres_failure(&r, host_error_text("E-HOST-PROCESS-SPAWN", er.spawn_error),
                     meta);
        return r;
    }
    if (er.have_code && er.code == 0) {
        hres_success(&r, stdoutv);
        r.meta = meta;
        return r;
    }
    {
        char detail[128];
        const char *message;
        if (stderrv->kind == J_STR && stderrv->str[0] != 0) {
            message = stderrv->str;
        } else {
            snprintf(detail, sizeof(detail), "进程退出码 %d", er.code);
            message = host_error_text("E-HOST-PROCESS-EXIT", detail);
        }
        hres_failure(&r, message, meta);
        return r;
    }
}

static HRes sh_dispatch(void *ctx, const char *verb, JVal *entry)
{
    ShellHost *h = (ShellHost *)ctx;
    return host_call(h->ops, verb, entry);
}

pub HostOps *sh_ops(ShellHost *h)
{
    HostOps *ops = (HostOps *)xmalloc(sizeof(HostOps));
    memset(ops, 0, sizeof(*ops));
    ops->ctx = h;
    ops->call = sh_dispatch;
    h->ops = ops;
    ops->fs_read = sh_fs_read;
    ops->fs_write = sh_fs_write;
    ops->env_get = sh_env_get;
    ops->process_run = sh_process_run;
    ops->stdio_write = sh_stdio_write;
    return ops;
}
