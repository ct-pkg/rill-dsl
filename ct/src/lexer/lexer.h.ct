// lexer — RILL 0.1.0 CT 多单元版（见 docs/phases/pending/ct-multiunit.md）

import common::common;

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>


/* ------------------------------------------------------------------ */
/* tokens                                                              */
/* ------------------------------------------------------------------ */

pub enum TokKind {
    TK_LBRACE,
    TK_RBRACE,
    TK_LPAREN,
    TK_RPAREN,
    TK_LBRACKET,
    TK_RBRACKET,
    TK_ARROW,
    TK_PIPE,
    TK_AT,
    TK_QUESTION,
    TK_COMMA,
    TK_KEYWORD,
    TK_BARE,
    TK_NUMBER,
    TK_STRING,
    TK_VARIABLE,
    TK_DOLLAR,
    TK_FIELD,
    TK_VERB,
    TK_MAP_REF,
    TK_MAP_HEADER,
    TK_FN_HEADER,
    TK_MAP_SHORT,
    TK_MAP_MARK,
    TK_MAP_LONG,
    TK_NEWLINE,
    TK_EOF
};

static const char *TOK_NAMES[] = {
    "LBRACE", "RBRACE", "LPAREN", "RPAREN", "LBRACKET", "RBRACKET",
    "ARROW", "PIPE", "AT", "QUESTION", "COMMA", "KEYWORD", "BARE",
    "NUMBER", "STRING", "VARIABLE", "DOLLAR", "FIELD", "VERB", "MAP_REF",
    "MAP_HEADER", "FN_HEADER", "MAP_SHORT", "MAP_MARK", "MAP_LONG",
    "NEWLINE", "EOF"
};

pub const char *tok_name(int kind) { return TOK_NAMES[kind]; }

pub struct Token {
    TokKind kind;
    char *text;
    int line;
    int col;
    int raw_len;
};

/* ------------------------------------------------------------------ */
/* lexer                                                               */
/* ------------------------------------------------------------------ */

pub struct Lexer {
    char *src;
    int n;
    int i;
    int line;
    int col;
    unsigned char prev;
    Token *toks;
    int ntoks;
    int cap;
    int map_mode;
    int map_line;
    int map_col;
    int fn_depth;
};

#define lx_peek(l, off) (((l)->i + (off) >= 0 && (l)->i + (off) < (l)->n) ? (unsigned char)(l)->src[(l)->i + (off)] : 0)

static void lx_advance(Lexer *l, int count)
{
    int k;
    for (k = 0; k < count; k++) {
        unsigned char ch;
        if (l->i >= l->n) return;
        ch = (unsigned char)l->src[l->i];
        l->i++;
        l->prev = ch;
        if (ch == '\n') {
            l->line++;
            l->col = 1;
        } else if (!is_utf8_cont(ch)) {
            l->col++;
        }
    }
}

static int cp_len_range(const char *s, int n)
{
    int i;
    int count = 0;
    for (i = 0; i < n; i++) {
        if (!is_utf8_cont((unsigned char)s[i])) count++;
    }
    return count;
}

static void lx_push(Lexer *l, TokKind kind, char *text, int raw_len, int line, int col)
{
    Token *slot;
    if (l->ntoks >= l->cap) {
        l->cap = l->cap ? l->cap * 2 : 64;
        l->toks = (Token *)xrealloc(l->toks, sizeof(Token) * (size_t)l->cap);
    }
    slot = &l->toks[l->ntoks];
    slot->kind = kind;
    slot->text = text;
    slot->line = line;
    slot->col = col;
    slot->raw_len = raw_len;
    l->ntoks++;
}

static void lx_emit(Lexer *l, TokKind kind, const char *text, int line, int col)
{
    lx_push(l, kind, xstrdup(text), cp_len(text), line, col);
}

static void lx_emit_slice(Lexer *l, TokKind kind, int start, int end, int line, int col)
{
    int n = end - start;
    lx_push(l, kind, xstrndup(l->src + start, n),
            cp_len_range(l->src + start, n), line, col);
}

static void lx_emit_raw(Lexer *l, TokKind kind, char *text, int raw, int len,
                        int line, int col)
{
    text[len] = 0;
    lx_push(l, kind, text, raw, line, col);
}

#define is_short_char(c) (is_alnum(c) || (c) == '_' || (c) == '-')
#define is_ident_start(c) ((c) == '_' || is_alpha(c))
#define is_ident_char(c) ((c) == '_' || is_alnum(c))
#define wordish_prev(c) ((c) != 0 && (is_word_byte(c) || in_set("_-.:'\"`", (c))))

static int match_number(Lexer *l)
{
    int p = l->i;
    int digits;
    unsigned char nxt;
    if (p < l->n && l->src[p] == '-') p++;
    digits = p;
    while (p < l->n && is_digit((unsigned char)l->src[p])) p++;
    if (p == digits) return -1;
    nxt = (p < l->n) ? (unsigned char)l->src[p] : 0;
    if (nxt != 0) {
        if (is_word_byte(nxt) || in_set("_.:-", nxt) || nxt == '\\') return -1;
    }
    return p;
}

/* 多单元后 159 字符的宏上限不再是问题：关键字判定改函数，不再重复宏体。 */
static int is_keyword(const char *text)
{
    static const char *KW[] = {"if", "else", "else-if", "each", "parallel",
                               "break"};
    int i;
    for (i = 0; i < 6; i++) {
        if (strcmp(text, KW[i]) == 0) return 1;
    }
    return 0;
}

static void lx_bare(Lexer *l)
{
    int start = l->i;
    int line = l->line;
    int col = l->col;
    while (l->i < l->n) {
        unsigned char ch = lx_peek(l, 0);
        if (is_space_byte(ch) || ch == '\n') break;
        if (in_set("<>()[]{}|@?,\"'`$", ch)) break;
        if (ch == '-' && lx_peek(l, 1) == '>') break;
        if (ch == '\\') {
            unsigned char nxt = lx_peek(l, 1);
            if (!in_set("[]()<>{}$\\", nxt)) {
                fail("tokenize", "E-LEX-BARE-ESCAPE", l->line, l->col,
                     "非法转义：裸词只允许 \\[ \\] \\( \\) \\< \\> \\{ \\} \\$ \\\\");
            }
            lx_advance(l, 2);
            continue;
        }
        lx_advance(l, 1);
    }
    if (l->i == start) {
        fail("tokenize", "E-LEX-CHAR", l->line, l->col, "无法识别的字符");
    }
    {
        char *text = xstrndup(l->src + start, l->i - start);
        TokKind kind = is_keyword(text) ? TK_KEYWORD : TK_BARE;
        lx_push(l, kind, text, l->col - col, line, col);
    }
}

static void lx_string(Lexer *l)
{
    int line = l->line;
    int col = l->col;
    unsigned char quote = lx_peek(l, 0);
    char *buf = (char *)xmalloc(16);
    int len = 0;
    int cap = 16;
    lx_advance(l, 1);
    for (;;) {
        unsigned char ch;
        if (l->i >= l->n || lx_peek(l, 0) == '\n') {
            fail("tokenize", "E-LEX-QUOTE", line, col,
                 "字符串未闭合：行尾前缺少结束引号");
        }
        ch = lx_peek(l, 0);
        if (ch == quote) {
            lx_advance(l, 1);
            break;
        }
        if (quote == '"' && ch == '\\') {
            unsigned char nxt = lx_peek(l, 1);
            if (nxt != '"' && nxt != '\\') {
                fail("tokenize", "E-LEX-ESCAPE", l->line, l->col,
                     "非法转义：双引号内只允许 \\\" 与 \\\\");
            }
            if (len + 1 >= cap) {
                cap *= 2;
                buf = (char *)xrealloc(buf, (size_t)cap);
            }
            buf[len++] = (char)nxt;
            lx_advance(l, 2);
            continue;
        }
        if (len + 1 >= cap) {
            cap *= 2;
            buf = (char *)xrealloc(buf, (size_t)cap);
        }
        buf[len++] = (char)ch;
        lx_advance(l, 1);
    }
    lx_emit_raw(l, TK_STRING, buf, l->col - col, len, line, col);
}

static void lx_verb(Lexer *l)
{
    int line = l->line;
    int col = l->col;
    int start;
    lx_advance(l, 1);
    start = l->i;
    while (l->i < l->n && lx_peek(l, 0) != '>' && lx_peek(l, 0) != '\n') {
        lx_advance(l, 1);
    }
    if (l->i >= l->n || lx_peek(l, 0) == '\n') {
        fail("tokenize", "E-02", line, col,
             "动词未闭合；映射定义必须在 `//map{}` 块内");
    }
    if (l->i == start) {
        fail("tokenize", "E-LEX-VERB", line, col,
             "动词名为空：<> 内至少要有一个字符");
    }
    lx_emit_slice(l, TK_VERB, start, l->i, line, col);
    lx_advance(l, 1);
    l->toks[l->ntoks - 1].raw_len = l->col - col;
}

static void lx_map_ref(Lexer *l)
{
    int line = l->line;
    int col = l->col;
    int start;
    lx_advance(l, 1);
    start = l->i;
    while (l->i < l->n && lx_peek(l, 0) != '`' && lx_peek(l, 0) != '\n') {
        lx_advance(l, 1);
    }
    if (l->i >= l->n || lx_peek(l, 0) == '\n') {
        fail("tokenize", "E-LEX-MAP-REF", line, col, "反引号引用未闭合");
    }
    lx_emit_slice(l, TK_MAP_REF, start, l->i, line, col);
    lx_advance(l, 1);
    l->toks[l->ntoks - 1].raw_len = l->col - col;
}

static void lx_comment_or_header(Lexer *l)
{
    int line = l->line;
    int col = l->col;
    int probe;
    const char *word = 0;
    int brace = -1;
    int c;
    const char *cands[2];

    if (l->fn_depth) {
        while (l->i < l->n && lx_peek(l, 0) != '\n') lx_advance(l, 1);
        return;
    }

    probe = l->i + 2;
    cands[0] = "map";
    cands[1] = "fn";
    for (c = 0; c < 2; c++) {
        int end = probe;
        int clen = (int)strlen(cands[c]);
        int after;
        while (end < l->n && is_space_byte((unsigned char)l->src[end])) end++;
        if (end + clen > l->n) continue;
        if (strncmp(l->src + end, cands[c], (size_t)clen) != 0) continue;
        after = end + clen;
        while (after < l->n && is_space_byte((unsigned char)l->src[after])) after++;
        if (after < l->n && l->src[after] == '{') {
            word = cands[c];
            brace = after;
            break;
        }
    }

    if (word != 0) {
        int is_map = (word[0] == 'm');
        lx_emit(l, is_map ? TK_MAP_HEADER : TK_FN_HEADER,
                is_map ? "//map" : "//fn", line, col);
        lx_advance(l, brace + 1 - l->i);
        if (is_map) {
            l->map_mode = 1;
            l->map_line = line;
            l->map_col = col;
        } else {
            l->fn_depth = 1;
        }
        return;
    }

    while (l->i < l->n && lx_peek(l, 0) != '\n') lx_advance(l, 1);
}

#define lx_map_unclosed(l) fail("tokenize", "E-LEX-MAP-UNCLOSED", (l)->map_line, (l)->map_col, "//map 区块未闭合：缺少 }")

static void lx_map_line(Lexer *l)
{
    int short_line;
    int short_col;
    int start;
    int mark_line;
    int mark_col;
    unsigned char marker;
    int long_line;
    int long_col;
    int long_start;
    int newline_line;
    int newline_col;

    while (lx_peek(l, 0) != 0 && is_space_byte(lx_peek(l, 0))) lx_advance(l, 1);

    if (l->i >= l->n) lx_map_unclosed(l);

    if (lx_peek(l, 0) == '\n') {
        newline_line = l->line;
        newline_col = l->col;
        lx_advance(l, 1);
        lx_emit(l, TK_NEWLINE, "\n", newline_line, newline_col);
        return;
    }

    if (lx_peek(l, 0) == '}') {
        lx_emit(l, TK_RBRACE, "}", l->line, l->col);
        lx_advance(l, 1);
        l->map_mode = 0;
        l->map_line = 0;
        l->map_col = 0;
        return;
    }

    short_line = l->line;
    short_col = l->col;
    start = l->i;
    while (l->i < l->n && is_short_char(lx_peek(l, 0))) lx_advance(l, 1);
    if (l->i == start) {
        fail("tokenize", "E-LEX-MAP-ENTRY", short_line, short_col,
             "map 行缺少短词：短词只允许字母、数字、- 和 _");
    }

    mark_line = l->line;
    mark_col = l->col;
    marker = lx_peek(l, 0);
    if (marker == 0 || marker == '\n') {
        fail("tokenize", "E-01", mark_line, mark_col, "map_entry 标记符非法");
    }
    if (marker != '\'' && marker != '`' && marker != '<') {
        fail("tokenize", "E-01", mark_line, mark_col,
             "map_entry 标记符非法：只允许 ' / ` / <");
    }

    lx_emit_slice(l, TK_MAP_SHORT, start, l->i, short_line, short_col);
    {
        char mark[2];
        mark[0] = (char)marker;
        mark[1] = 0;
        lx_emit(l, TK_MAP_MARK, mark, mark_line, mark_col);
    }
    lx_advance(l, 1);

    long_line = l->line;
    long_col = l->col;
    long_start = l->i;
    while (l->i < l->n && lx_peek(l, 0) != '\n') lx_advance(l, 1);
    lx_emit_slice(l, TK_MAP_LONG, long_start, l->i, long_line, long_col);

    if (l->i >= l->n) lx_map_unclosed(l);

    newline_line = l->line;
    newline_col = l->col;
    lx_advance(l, 1);
    lx_emit(l, TK_NEWLINE, "\n", newline_line, newline_col);
}

static void lx_normal(Lexer *l)
{
    unsigned char ch = lx_peek(l, 0);

    if (is_space_byte(ch)) {
        lx_advance(l, 1);
        return;
    }
    if (ch == '\n') {
        int line = l->line;
        int col = l->col;
        lx_advance(l, 1);
        lx_emit(l, TK_NEWLINE, "\n", line, col);
        return;
    }
    if (ch == '#' && lx_peek(l, 1) == '!' && l->line == 1 && l->col == 1) {
        /* 只认首行首列的 `#!`：整行按注释丢掉，换行仍由下一个 token 发出，
           这样行号列号与后续诊断不受影响。 */
        while (l->i < l->n && lx_peek(l, 0) != '\n') lx_advance(l, 1);
        return;
    }
    if (ch == '/' && lx_peek(l, 1) == '/') {
        lx_comment_or_header(l);
        return;
    }
    if (ch == '(' || ch == ')' || ch == '[' || ch == ']' ||
        ch == '{' || ch == '}') {
        TokKind kind;
        if (ch == '(') kind = TK_LPAREN;
        else if (ch == ')') kind = TK_RPAREN;
        else if (ch == '[') kind = TK_LBRACKET;
        else if (ch == ']') kind = TK_RBRACKET;
        else if (ch == '{') kind = TK_LBRACE;
        else kind = TK_RBRACE;
        {
            char one[2];
            one[0] = (char)ch;
            one[1] = 0;
            lx_emit(l, kind, one, l->line, l->col);
        }
        lx_advance(l, 1);
        if (l->fn_depth) {
            if (ch == '{') l->fn_depth++;
            else if (ch == '}') l->fn_depth--;
        }
        return;
    }
    if (ch == '<') {
        lx_verb(l);
        return;
    }
    if (ch == '>') {
        fail("tokenize", "E-LEX-GT", l->line, l->col,
             "孤立的 >：动词必须写成 <name>");
    }
    if (ch == '-' && lx_peek(l, 1) == '>') {
        lx_emit(l, TK_ARROW, "->", l->line, l->col);
        lx_advance(l, 2);
        return;
    }
    if (ch == '|') {
        if (lx_peek(l, 1) == '>') {
            lx_emit(l, TK_PIPE, "|>", l->line, l->col);
            lx_advance(l, 2);
            return;
        }
        fail("tokenize", "E-LEX-PIPE", l->line, l->col,
             "孤立的 |：管道符号必须是 |>");
    }
    if (ch == '@') {
        lx_emit(l, TK_AT, "@", l->line, l->col);
        lx_advance(l, 1);
        return;
    }
    if (ch == '?') {
        lx_emit(l, TK_QUESTION, "?", l->line, l->col);
        lx_advance(l, 1);
        return;
    }
    if (ch == ',') {
        lx_emit(l, TK_COMMA, ",", l->line, l->col);
        lx_advance(l, 1);
        return;
    }
    if (ch == '$') {
        int line = l->line;
        int col = l->col;
        int start;
        lx_advance(l, 1);
        start = l->i;
        while (l->i < l->n && is_ident_char(lx_peek(l, 0))) lx_advance(l, 1);
        if (l->i == start) {
            lx_emit(l, TK_DOLLAR, "$", line, col);
        } else {
            lx_emit_slice(l, TK_VARIABLE, start, l->i, line, col);
            l->toks[l->ntoks - 1].raw_len += 1;
        }
        return;
    }
    if (ch == '\'' || ch == '"') {
        lx_string(l);
        return;
    }
    if (ch == '`') {
        lx_map_ref(l);
        return;
    }
    if (ch == '.' && is_ident_start(lx_peek(l, 1)) && !wordish_prev(l->prev)) {
        int line = l->line;
        int col = l->col;
        int start;
        lx_advance(l, 1);
        start = l->i;
        while (l->i < l->n && is_ident_char(lx_peek(l, 0))) lx_advance(l, 1);
        lx_emit_slice(l, TK_FIELD, start, l->i, line, col);
        l->toks[l->ntoks - 1].raw_len += 1;
        return;
    }
    if (!wordish_prev(l->prev)) {
        int end = match_number(l);
        if (end >= 0) {
            int line = l->line;
            int col = l->col;
            lx_emit_slice(l, TK_NUMBER, l->i, end, line, col);
            lx_advance(l, end - l->i);
            return;
        }
    }
    lx_bare(l);
}

pub void lexer_run(Lexer *l)
{
    while (l->i < l->n) {
        if (l->map_mode) lx_map_line(l);
        else lx_normal(l);
    }
    if (l->map_mode) lx_map_unclosed(l);
    lx_emit(l, TK_EOF, "", l->line, l->col);
}
