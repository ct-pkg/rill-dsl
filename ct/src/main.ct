// main — RILL 0.1.0 CT 多单元版（见 docs/phases/pending/ct-multiunit.md）

#include "bridge.h"

import cli::cli;

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>

#define usage_fail(...) fail("cli", "E_USAGE", 0, 0, __VA_ARGS__)

int main(int argc, char **argv)
{
    StdoutEmitter out;

    if (setjmp(*fail_jmp_slot()) != 0) {
        out.failed = 0;
        emitter_emit(&out, 0, 0);
        return 2;
    }

    if (argc < 2) usage_fail("缺少子命令");
    if (strcmp(argv[1], "tokenize") == 0) {
        return cmd_tokenize(argc - 2, argv + 2);
    }
    if (strcmp(argv[1], "parse") == 0) {
        return cmd_parse(argc - 2, argv + 2);
    }
    if (strcmp(argv[1], "check") == 0) {
        return cmd_check(argc - 2, argv + 2);
    }
    if (strcmp(argv[1], "run") == 0) {
        return cmd_run(argc - 2, argv + 2);
    }
    if (strcmp(argv[1], "fmt") == 0) {
        return cmd_fmt(argc - 2, argv + 2);
    }
    if (strcmp(argv[1], "-h") == 0 || strcmp(argv[1], "--help") == 0) {
        printf("usage: rill tokenize <file> | rill parse --dump-ast <file> "
               "[--profile shell|agent] | rill check <file> "
               "[--profile shell|agent] | rill run <file> "
               "[--fakes <json>] [--profile shell|agent] | rill fmt "
               "--compress|--display <file> | rill <file>\n");
        return 0;
    }
    {
        /* shebang 入口：`#!/usr/bin/env rill` 只会把脚本路径传进来，没有子命令。
           首个实参是可读文件时按 `run` 处理。 */
        FILE *probe = fopen(argv[1], "rb");
        if (probe != 0) {
            fclose(probe);
            return cmd_run(argc - 1, argv + 1);
        }
    }
    usage_fail("未知子命令 %s", argv[1]);
    return 2;
}
