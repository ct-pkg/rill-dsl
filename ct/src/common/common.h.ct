// common — RILL 0.1.0 CT 多单元版（见 docs/phases/pending/ct-multiunit.md）

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <setjmp.h>


/*
 * rill_ct.ct - RILL 0.1.0 first layer in CT (C with traits).
 *
 * Pipeline: read a .ri file -> tokenize -> parse -> emit JSON.
 * The observable contract is deliberately the same as the Python reference in
 * src/rill/: exit 0 with {"tokens":[...]} or {"ast":...}, exit 2 with
 * {"error":{stage,code,line,col,message}}.  Stages are "tokenize" and "parse".
 *
 * This unit is written in the C subset of CT plus one trait for the CLI's
 * diagnostic sink; it compiles with `ctc` and then with `cc -std=c99`.
 * See ct/README.md for the build command and the rule-by-rule mapping notes.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <setjmp.h>

/* ------------------------------------------------------------------ */
/* diagnostics                                                         */
/* ------------------------------------------------------------------ */

pub struct Diag {
    const char *stage;
    const char *code;
    int line;
    int col;
    char message[512];
};

/* `ct build --lib` 拒绝导出 pub 全局量，这两个值改成本单元私有，
   跨层只经 `fail_jmp_slot()` 取地址（main 的 setjmp 仍落在 main 帧）。 */
static Diag g_diag;
static jmp_buf g_fail_jmp;

pub jmp_buf *fail_jmp_slot(void) { return &g_fail_jmp; }

static void failv(const char *stage, const char *code, int line, int col,
                  const char *fmt, va_list ap)
{
    g_diag.stage = stage;
    g_diag.code = code;
    g_diag.line = line;
    g_diag.col = col;
    vsnprintf(g_diag.message, sizeof(g_diag.message), fmt, ap);
    longjmp(g_fail_jmp, 1);
}

pub void fail(const char *stage, const char *code, int line, int col,
              const char *fmt, ...)
{
    va_list ap;
    va_start(ap, fmt);
    failv(stage, code, line, col, fmt, ap);
    va_end(ap);
}

/* The CLI reports usage problems with the same envelope as the reference. */
#define usage_fail(...) fail("cli", "E_USAGE", 0, 0, __VA_ARGS__)

/* ------------------------------------------------------------------ */
/* small helpers                                                       */
/* ------------------------------------------------------------------ */

pub void *xrealloc(void *p, size_t n)
{
    void *q = realloc(p, n ? n : 1);
    if (q == 0) abort();
    return q;
}

pub char *xstrndup(const char *s, int n)
{
    char *p = (char *)xrealloc(0, (size_t)n + 1);
    if (n > 0) memcpy(p, s, (size_t)n);
    p[n] = 0;
    return p;
}

/* 单文件时代的省槽宏在多单元下没有存在必要，统一改成可共享函数。 */
pub void *xmalloc(size_t n) { return xrealloc(0, n); }
pub char *xstrdup(const char *s) { return xstrndup(s, (int)strlen(s)); }

pub int is_digit(int c) { return c >= '0' && c <= '9'; }
pub int is_alpha(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}
pub int is_alnum(int c) { return is_digit(c) || is_alpha(c); }

/* Python's str.isalnum() is true for non-ASCII letters too; every byte of a
   multi-byte UTF-8 sequence is >= 0x80, so this is the intended approximation. */
pub int is_word_byte(int c) { return is_alnum(c) || c >= 0x80; }
pub int is_utf8_cont(int c) { return (c & 0xC0) == 0x80; }
pub int in_set(const char *set, int c)
{
    return c != 0 && strchr(set, c) != 0;
}
pub int is_space_byte(int c) { return c == ' ' || c == '\t'; }

/* Code-point length, which is what Python uses for token text widths. */
pub int cp_len(const char *s)
{
    int n = 0;
    const unsigned char *p = (const unsigned char *)s;
    while (*p) {
        if (!is_utf8_cont(*p)) n++;
        p++;
    }
    return n;
}

/* ------------------------------------------------------------------ */
/* JSON value tree                                                     */
/* ------------------------------------------------------------------ */

pub enum JKind {
    J_NULL,
    J_BOOL,
    J_INT,
    J_FLOAT,
    J_STR,
    J_BYTES,
    J_ARR,
    J_OBJ
};

pub struct JVal {
    JKind kind;
    int boolean;
    long long num;
    double dbl;
    char *str;
    JVal **items;
    char **keys;
    int len;
    int cap;
};

static JVal *jnew(JKind kind, long long num, const char *s, int n)
{
    JVal *v = (JVal *)xmalloc(sizeof(JVal));
    memset(v, 0, sizeof(*v));
    v->kind = kind;
    v->num = num;
    if (kind == J_BOOL) v->boolean = num ? 1 : 0;
    if (kind == J_STR) {
        v->str = (n < 0) ? xstrdup(s) : xstrndup(s, n);
    }
    return v;
}

pub JVal *jnull(void) { return jnew(J_NULL, 0, 0, 0); }
pub JVal *jbool(int b) { return jnew(J_BOOL, b, 0, 0); }
pub JVal *jint(long long n) { return jnew(J_INT, n, 0, 0); }
pub JVal *jstr(const char *s) { return jnew(J_STR, 0, s, -1); }
pub JVal *jstrn(const char *s, int n) { return jnew(J_STR, 0, s, n); }

pub JVal *jnum(double value)
{
    JVal *v = jnull();
    v->kind = J_FLOAT;
    v->dbl = value;
    return v;
}

/* PH-19：非法 UTF-8 不做有损替换，原样保留。len 存在 num，
   数据存在 str（额外补 0 便于按 C 串调试）；写出时按 base64 包裹。 */
pub JVal *jbytes(const char *data, int n)
{
    JVal *v = (JVal *)xmalloc(sizeof(JVal));
    memset(v, 0, sizeof(*v));
    v->kind = J_BYTES;
    v->num = n;
    v->str = (char *)xmalloc((size_t)n + 1);
    if (n > 0) memcpy(v->str, data, (size_t)n);
    v->str[n] = 0;
    return v;
}
pub JVal *jarr(void) { return jnew(J_ARR, 0, 0, 0); }
pub JVal *jobj(void) { return jnew(J_OBJ, 0, 0, 0); }

pub void jgrow(JVal *v)
{
    if (v->len < v->cap) return;
    v->cap = v->cap ? v->cap * 2 : 4;
    v->items = (JVal **)xrealloc(v->items, sizeof(JVal *) * (size_t)v->cap);
    if (v->kind == J_OBJ) {
        v->keys = (char **)xrealloc(v->keys, sizeof(char *) * (size_t)v->cap);
    }
}

pub int jpush(JVal *arr, JVal *item)
{
    jgrow(arr);
    arr->items[arr->len++] = item;
    return 0;
}

pub JVal *jput(JVal *obj, const char *key, JVal *val)
{
    jgrow(obj);
    obj->keys[obj->len] = xstrdup(key);
    obj->items[obj->len] = val;
    obj->len++;
    return obj;
}

pub JVal *jget(JVal *obj, const char *key)
{
    int i;
    if (obj == 0 || obj->kind != J_OBJ) return 0;
    for (i = 0; i < obj->len; i++) {
        if (strcmp(obj->keys[i], key) == 0) return obj->items[i];
    }
    return 0;
}

/* PH-16 用宏省槽时重复查键；多单元下改函数，只查一次。 */
pub const char *jget_str(JVal *obj, const char *key)
{
    JVal *v = jget(obj, key);
    return (v != 0 && v->kind == J_STR) ? v->str : "";
}

static void jwrite_string(FILE *out, const char *s)
{
    const unsigned char *p = (const unsigned char *)s;
    fputc('"', out);
    while (*p) {
        unsigned char c = *p;
        switch (c) {
        case '"': fputs("\\\"", out); break;
        case '\\': fputs("\\\\", out); break;
        case '\b': fputs("\\b", out); break;
        case '\f': fputs("\\f", out); break;
        case '\n': fputs("\\n", out); break;
        case '\r': fputs("\\r", out); break;
        case '\t': fputs("\\t", out); break;
        default:
            if (c < 0x20) {
                fprintf(out, "\\u%04x", (unsigned)c);
            } else {
                fputc((int)c, out);
            }
        }
        p++;
    }
    fputc('"', out);
}

/* 只读的伪宿主/能力清单 JSON。标准 JSON 子集：对象/数组/字符串/
   整数/true/false/null。递归下降，深度由输入自身限制。
   PH-19 从 eval 上移到 common：能力清单与 fakes 都要读 JSON。 */
pub JVal *json_parse(const char *s, int *pos)
{
    JVal *v = 0;
    char c;
    int i;
    while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
           s[*pos] == '\r') {
        (*pos)++;
    }
    c = s[*pos];
    if (c == '{') {
        v = jobj();
        (*pos)++;
        for (;;) {
            JVal *key;
            JVal *val;
            while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
                   s[*pos] == '\r') {
                (*pos)++;
            }
            if (s[*pos] == '}') {
                (*pos)++;
                return v;
            }
            key = json_parse(s, pos);
            while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
                   s[*pos] == '\r') {
                (*pos)++;
            }
            if (s[*pos] == ':') (*pos)++;
            val = json_parse(s, pos);
            jput(v, key->str, val);
            while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
                   s[*pos] == '\r') {
                (*pos)++;
            }
            if (s[*pos] == ',') {
                (*pos)++;
                continue;
            }
            if (s[*pos] == '}') {
                (*pos)++;
                return v;
            }
            return v;
        }
    }
    if (c == '[') {
        v = jarr();
        (*pos)++;
        for (;;) {
            while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
                   s[*pos] == '\r') {
                (*pos)++;
            }
            if (s[*pos] == ']') {
                (*pos)++;
                return v;
            }
            jpush(v, json_parse(s, pos));
            while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
                   s[*pos] == '\r') {
                (*pos)++;
            }
            if (s[*pos] == ',') {
                (*pos)++;
                continue;
            }
            if (s[*pos] == ']') {
                (*pos)++;
                return v;
            }
            return v;
        }
    }
    if (c == '"') {
        int cap = 32;
        int len = 0;
        char *buf = (char *)xmalloc((size_t)cap);
        (*pos)++;
        while (s[*pos] && s[*pos] != '"') {
            char ch = s[*pos];
            if (ch == '\\') {
                (*pos)++;
                ch = s[*pos];
                if (ch == 'n') ch = '\n';
                else if (ch == 't') ch = '\t';
                else if (ch == 'r') ch = '\r';
                else if (ch == 'b') ch = '\b';
                else if (ch == 'f') ch = '\f';
                else if (ch == 'u') {
                    ch = '?';
                    for (i = 0; i < 4 && s[*pos + 1 + i]; i++) (*pos)++;
                }
            }
            if (len + 1 >= cap) {
                cap *= 2;
                buf = (char *)xrealloc(buf, (size_t)cap);
            }
            buf[len++] = ch;
            if (s[*pos]) (*pos)++;
        }
        if (s[*pos] == '"') (*pos)++;
        v = jstrn(buf, len);
        free(buf);
        return v;
    }
    if (strncmp(s + *pos, "true", 4) == 0) {
        *pos += 4;
        return jbool(1);
    }
    if (strncmp(s + *pos, "false", 5) == 0) {
        *pos += 5;
        return jbool(0);
    }
    if (strncmp(s + *pos, "null", 4) == 0) {
        *pos += 4;
        return jnull();
    }
    {
        long long num = 0;
        int neg = 0;
        if (s[*pos] == '-') {
            neg = 1;
            (*pos)++;
        }
        while (is_digit(s[*pos])) {
            num = num * 10 + (s[*pos] - '0');
            (*pos)++;
        }
        return jint(neg ? -num : num);
    }
}

pub char *xbase64(const char *data, int n)
{
    static const char *alphabet =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    const unsigned char *raw = (const unsigned char *)data;
    int cap = ((n + 2) / 3) * 4 + 1;
    char *out = (char *)xmalloc((size_t)cap);
    int i;
    int pos = 0;
    for (i = 0; i + 2 < n; i += 3) {
        unsigned int v = ((unsigned)raw[i] << 16) |
                         ((unsigned)raw[i + 1] << 8) |
                         (unsigned)raw[i + 2];
        out[pos++] = alphabet[(v >> 18) & 63];
        out[pos++] = alphabet[(v >> 12) & 63];
        out[pos++] = alphabet[(v >> 6) & 63];
        out[pos++] = alphabet[v & 63];
    }
    if (i < n) {
        unsigned int v = (unsigned)raw[i] << 16;
        if (i + 1 < n) v |= (unsigned)raw[i + 1] << 8;
        out[pos++] = alphabet[(v >> 18) & 63];
        out[pos++] = alphabet[(v >> 12) & 63];
        out[pos++] = i + 1 < n ? alphabet[(v >> 6) & 63] : '=';
        out[pos++] = '=';
    }
    out[pos] = 0;
    return out;
}

pub char *xb64decode(const char *s, int *out_len)
{
    int n = (int)strlen(s);
    char *out = (char *)xmalloc((size_t)n + 1);
    int pos = 0;
    int acc = 0;
    int bits = 0;
    int i;
    for (i = 0; i < n; i++) {
        char c = s[i];
        int v;
        if (c >= 'A' && c <= 'Z') v = c - 'A';
        else if (c >= 'a' && c <= 'z') v = c - 'a' + 26;
        else if (c >= '0' && c <= '9') v = c - '0' + 52;
        else if (c == '+') v = 62;
        else if (c == '/') v = 63;
        else continue;
        acc = (acc << 6) | v;
        bits += 6;
        if (bits >= 8) {
            bits -= 8;
            out[pos++] = (char)((acc >> bits) & 0xFF);
        }
    }
    out[pos] = 0;
    *out_len = pos;
    return out;
}

pub void jfmt_double(char *buf, size_t cap, double value)
{
    char *dot;
    char *end;
    snprintf(buf, cap, "%.3f", value);
    dot = strchr(buf, '.');
    if (dot == 0) return;
    end = buf + strlen(buf) - 1;
    while (end > dot + 1 && *end == '0') {
        *end = 0;
        end--;
    }
}

/* ``Bytes.data.decode("utf-8", "replace")`` 的近似：坏字节逐字节替换。
   （Python 对截断多字节可能合并成一个 U+FFFD；未覆盖语料，见 PH-19 §9 #8。） */
pub char *jbytes_text(JVal *v)
{
    const unsigned char *s = (const unsigned char *)v->str;
    int n = (int)v->num;
    int i = 0;
    int cap = n + 8;
    int len = 0;
    char *out = (char *)xmalloc((size_t)cap);
    while (i < n) {
        unsigned char c = s[i];
        int need;
        int valid = 1;
        int k;
        if (c < 0x80) need = 0;
        else if ((c & 0xE0) == 0xC0) need = 1;
        else if ((c & 0xF0) == 0xE0) need = 2;
        else if ((c & 0xF8) == 0xF0) need = 3;
        else {
            need = 0;
            valid = 0;
        }
        if (valid) {
            if (i + need >= n) {
                valid = 0;
            } else {
                for (k = 1; k <= need; k++) {
                    if ((s[i + k] & 0xC0) != 0x80) {
                        valid = 0;
                        break;
                    }
                }
            }
        }
        if (len + 5 > cap) {
            cap *= 2;
            out = (char *)xrealloc(out, (size_t)cap);
        }
        if (valid) {
            memcpy(out + len, s + i, (size_t)(need + 1));
            len += need + 1;
            i += need + 1;
        } else {
            memcpy(out + len, "\xEF\xBF\xBD", 3);
            len += 3;
            i++;
        }
    }
    out[len] = 0;
    return out;
}

pub void jdump(FILE *out, JVal *v)
{
    int i;
    if (v == 0) {
        fputs("null", out);
        return;
    }
    switch (v->kind) {
    case J_NULL: fputs("null", out); break;
    case J_BOOL: fputs(v->boolean ? "true" : "false", out); break;
    case J_INT: fprintf(out, "%lld", v->num); break;
    case J_FLOAT: {
        char num[64];
        jfmt_double(num, sizeof(num), v->dbl);
        fputs(num, out);
        break;
    }
    case J_STR: jwrite_string(out, v->str); break;
    case J_BYTES: {
        char *raw = xbase64(v->str, (int)v->num);
        fputs("{\"$bytes\":", out);
        jwrite_string(out, raw);
        fputc('}', out);
        free(raw);
        break;
    }
    case J_ARR:
        fputc('[', out);
        for (i = 0; i < v->len; i++) {
            if (i) fputc(',', out);
            jdump(out, v->items[i]);
        }
        fputc(']', out);
        break;
    case J_OBJ:
        fputc('{', out);
        for (i = 0; i < v->len; i++) {
            if (i) fputc(',', out);
            jwrite_string(out, v->keys[i]);
            fputc(':', out);
            jdump(out, v->items[i]);
        }
        fputc('}', out);
        break;
    }
}

/* A trait is used for the one place where the same call site has to write to
   stdout for success and to a diagnostic envelope on failure. */
pub trait Emitter {
    void emit(const char *field, JVal *value);
}

pub struct StdoutEmitter {
    int failed;
} use Emitter;

/* 跨层（--lib 之外）的单元不认识 Emitter，`out.emit()` 会落到未初始化的
   `__emitter_vptr` 上；真正写输出的逻辑因此放在这个自由函数里，trait 方法只转发。 */
pub void emitter_emit(StdoutEmitter *self, const char *field, JVal *value)
{
    JVal *root = jobj();
    if (field == 0) {
        JVal *err = jobj();
        jput(err, "stage", jstr(g_diag.stage));
        jput(err, "code", jstr(g_diag.code));
        jput(err, "line", jint(g_diag.line));
        jput(err, "col", jint(g_diag.col));
        jput(err, "message", jstr(g_diag.message));
        jput(root, "error", err);
        self->failed = 1;
    } else {
        jput(root, field, value);
    }
    jdump(stdout, root);
    fputc('\n', stdout);
    fflush(stdout);
}

impl Emitter for StdoutEmitter {
    void emit(const char *field, JVal *value) {
        emitter_emit(self, field, value);
    }
}
