// common — RILL 0.1.0 CT 多单元版（见 docs/phases/pending/ct-multiunit.md）

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <setjmp.h>


/*
 * rill_ct.ct - RILL 0.1.0 first layer in CT (C with traits).
 *
 * Pipeline: read a .ri file -> tokenize -> parse -> emit JSON.
 * The observable contract is deliberately the same as the Python reference in
 * src/rill/: exit 0 with {"tokens":[...]} or {"ast":...}, exit 2 with
 * {"error":{stage,code,line,col,message}}.  Stages are "tokenize" and "parse".
 *
 * This unit is written in the C subset of CT plus one trait for the CLI's
 * diagnostic sink; it compiles with `ctc` and then with `cc -std=c99`.
 * See ct/README.md for the build command and the rule-by-rule mapping notes.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <setjmp.h>

/* ------------------------------------------------------------------ */
/* diagnostics                                                         */
/* ------------------------------------------------------------------ */

pub struct Diag {
    const char *stage;
    const char *code;
    int line;
    int col;
    char message[512];
};

/* `ct build --lib` 拒绝导出 pub 全局量，这两个值改成本单元私有，
   跨层只经 `fail_jmp_slot()` 取地址（main 的 setjmp 仍落在 main 帧）。 */
static Diag g_diag;
static char g_hint[512];
static int g_has_hint;
static jmp_buf g_fail_jmp;

pub jmp_buf *fail_jmp_slot(void) { return &g_fail_jmp; }

static void failv(const char *stage, const char *code, int line, int col,
                  const char *fmt, va_list ap)
{
    g_diag.stage = stage;
    g_diag.code = code;
    g_diag.line = line;
    g_diag.col = col;
    vsnprintf(g_diag.message, sizeof(g_diag.message), fmt, ap);
    longjmp(g_fail_jmp, 1);
}

pub void fail(const char *stage, const char *code, int line, int col,
              const char *fmt, ...)
{
    va_list ap;
    g_has_hint = 0;
    va_start(ap, fmt);
    failv(stage, code, line, col, fmt, ap);
    va_end(ap);
}

/* PH-22：带 Hint 的诊断。旧错误不走这里，信封字段集保持不变。 */
pub void fail_hint(const char *stage, const char *code, int line, int col,
                   const char *hint, const char *fmt, ...)
{
    va_list ap;
    snprintf(g_hint, sizeof(g_hint), "%s", hint ? hint : "");
    g_has_hint = 1;
    va_start(ap, fmt);
    failv(stage, code, line, col, fmt, ap);
    va_end(ap);
}

/* The CLI reports usage problems with the same envelope as the reference. */
#define usage_fail(...) fail("cli", "E_USAGE", 0, 0, __VA_ARGS__)

/* ------------------------------------------------------------------ */
/* small helpers                                                       */
/* ------------------------------------------------------------------ */

pub void *xrealloc(void *p, size_t n)
{
    void *q = realloc(p, n ? n : 1);
    if (q == 0) abort();
    return q;
}

pub char *xstrndup(const char *s, int n)
{
    char *p = (char *)xrealloc(0, (size_t)n + 1);
    if (n > 0) memcpy(p, s, (size_t)n);
    p[n] = 0;
    return p;
}

/* 单文件时代的省槽宏在多单元下没有存在必要，统一改成可共享函数。 */
pub void *xmalloc(size_t n) { return xrealloc(0, n); }
pub char *xstrdup(const char *s) { return xstrndup(s, (int)strlen(s)); }

pub int is_digit(int c) { return c >= '0' && c <= '9'; }
pub int is_alpha(int c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}
pub int is_alnum(int c) { return is_digit(c) || is_alpha(c); }

/* Python's str.isalnum() is true for non-ASCII letters too; every byte of a
   multi-byte UTF-8 sequence is >= 0x80, so this is the intended approximation. */
pub int is_word_byte(int c) { return is_alnum(c) || c >= 0x80; }
pub int is_utf8_cont(int c) { return (c & 0xC0) == 0x80; }
pub int in_set(const char *set, int c)
{
    return c != 0 && strchr(set, c) != 0;
}
pub int is_space_byte(int c) { return c == ' ' || c == '\t'; }

/* Code-point length, which is what Python uses for token text widths. */
pub int cp_len(const char *s)
{
    int n = 0;
    const unsigned char *p = (const unsigned char *)s;
    while (*p) {
        if (!is_utf8_cont(*p)) n++;
        p++;
    }
    return n;
}

/* ------------------------------------------------------------------ */
/* JSON value tree                                                     */
/* ------------------------------------------------------------------ */

pub enum JKind {
    J_NULL,
    J_BOOL,
    J_INT,
    J_FLOAT,
    J_STR,
    J_BYTES,
    J_ARR,
    J_OBJ
};

pub struct JVal {
    JKind kind;
    int boolean;
    long long num;
    double dbl;
    char *str;
    JVal **items;
    char **keys;
    int len;
    int cap;
};

static JVal *jnew(JKind kind, long long num, const char *s, int n)
{
    JVal *v = (JVal *)xmalloc(sizeof(JVal));
    memset(v, 0, sizeof(*v));
    v->kind = kind;
    v->num = num;
    if (kind == J_BOOL) v->boolean = num ? 1 : 0;
    if (kind == J_STR) {
        v->str = (n < 0) ? xstrdup(s) : xstrndup(s, n);
    }
    return v;
}

pub JVal *jnull(void) { return jnew(J_NULL, 0, 0, 0); }
pub JVal *jbool(int b) { return jnew(J_BOOL, b, 0, 0); }
pub JVal *jint(long long n) { return jnew(J_INT, n, 0, 0); }
pub JVal *jstr(const char *s) { return jnew(J_STR, 0, s, -1); }
pub JVal *jstrn(const char *s, int n) { return jnew(J_STR, 0, s, n); }

pub JVal *jnum(double value)
{
    JVal *v = jnull();
    v->kind = J_FLOAT;
    v->dbl = value;
    return v;
}

/* PH-19：非法 UTF-8 不做有损替换，原样保留。len 存在 num，
   数据存在 str（额外补 0 便于按 C 串调试）；写出时按 base64 包裹。 */
pub JVal *jbytes(const char *data, int n)
{
    JVal *v = (JVal *)xmalloc(sizeof(JVal));
    memset(v, 0, sizeof(*v));
    v->kind = J_BYTES;
    v->num = n;
    v->str = (char *)xmalloc((size_t)n + 1);
    if (n > 0) memcpy(v->str, data, (size_t)n);
    v->str[n] = 0;
    return v;
}
pub JVal *jarr(void) { return jnew(J_ARR, 0, 0, 0); }
pub JVal *jobj(void) { return jnew(J_OBJ, 0, 0, 0); }

pub void jgrow(JVal *v)
{
    if (v->len < v->cap) return;
    v->cap = v->cap ? v->cap * 2 : 4;
    v->items = (JVal **)xrealloc(v->items, sizeof(JVal *) * (size_t)v->cap);
    if (v->kind == J_OBJ) {
        v->keys = (char **)xrealloc(v->keys, sizeof(char *) * (size_t)v->cap);
    }
}

pub int jpush(JVal *arr, JVal *item)
{
    jgrow(arr);
    arr->items[arr->len++] = item;
    return 0;
}

pub JVal *jput(JVal *obj, const char *key, JVal *val)
{
    jgrow(obj);
    obj->keys[obj->len] = xstrdup(key);
    obj->items[obj->len] = val;
    obj->len++;
    return obj;
}

pub JVal *jget(JVal *obj, const char *key)
{
    int i;
    if (obj == 0 || obj->kind != J_OBJ) return 0;
    for (i = 0; i < obj->len; i++) {
        if (strcmp(obj->keys[i], key) == 0) return obj->items[i];
    }
    return 0;
}

/* PH-16 用宏省槽时重复查键；多单元下改函数，只查一次。 */
pub const char *jget_str(JVal *obj, const char *key)
{
    JVal *v = jget(obj, key);
    return (v != 0 && v->kind == J_STR) ? v->str : "";
}

/* ------------------------------------------------------------------ */
/* PH-22：函数形状键（D-022），parser / loader / eval 共用              */
/* ------------------------------------------------------------------ */

pub int jval_equal(JVal *a, JVal *b)
{
    int i;
    if (a == 0 || b == 0) return a == b;
    if (a->kind != b->kind) return 0;
    switch (a->kind) {
    case J_NULL:
        return 1;
    case J_BOOL:
        return a->boolean == b->boolean;
    case J_INT:
        return a->num == b->num;
    case J_STR:
        return strcmp(a->str, b->str) == 0;
    case J_ARR:
        if (a->len != b->len) return 0;
        for (i = 0; i < a->len; i++) {
            if (!jval_equal(a->items[i], b->items[i])) return 0;
        }
        return 1;
    case J_OBJ:
        if (a->len != b->len) return 0;
        for (i = 0; i < a->len; i++) {
            JVal *other = jget(b, a->keys[i]);
            if (other == 0 || !jval_equal(a->items[i], other)) return 0;
        }
        return 1;
    default:
        return a->num == b->num && a->dbl == b->dbl;
    }
}

/* P-025 未裁定前：常量位的 ``类型:值`` 前缀不进形状键。 */
static char *shape_strip_type(const char *text)
{
    const char *colon = strchr(text, ':');
    const char *p;
    if (colon == 0 || colon == text || colon[1] == 0) return xstrdup(text);
    if (!(is_alpha((unsigned char)text[0]) || text[0] == '_')) return xstrdup(text);
    for (p = text; p < colon; p++) {
        unsigned char c = (unsigned char)*p;
        if (!(is_alnum(c) || c == '_' || c == '-')) return xstrdup(text);
    }
    return xstrdup(colon + 1);
}

static char *shape_const_value(JVal *node)
{
    const char *kind;
    if (node == 0 || node->kind != J_OBJ) return 0;
    kind = jget_str(node, "kind");
    if (strcmp(kind, "String") == 0) return shape_strip_type(jget_str(node, "value"));
    if (strcmp(kind, "Bare") == 0) return shape_strip_type(jget_str(node, "text"));
    if (strcmp(kind, "Number") == 0) {
        JVal *v = jget(node, "value");
        char buf[64];
        snprintf(buf, sizeof(buf), "%lld", v != 0 ? v->num : 0);
        return xstrdup(buf);
    }
    return 0;
}

pub JVal *shape_slot(JVal *node, int template_side)
{
    JVal *o = jobj();
    const char *kind;
    char *value;
    if (node == 0 || node->kind == J_NULL) {
        jput(o, "role", jstr("none"));
        return o;
    }
    kind = jget_str(node, "kind");
    if (strcmp(kind, "Variable") == 0 || strcmp(kind, "Default") == 0) {
        jput(o, "role", jstr(template_side ? "param" : "value"));
        return o;
    }
    value = shape_const_value(node);
    if (value != 0) {
        jput(o, "role", jstr("const"));
        jput(o, "value", jstr(value));
        return o;
    }
    jput(o, "role", jstr("value"));
    return o;
}

static char *shape_before_colon(const char *text)
{
    const char *colon = strchr(text, ':');
    if (colon == 0) return xstrdup(text);
    return xstrndup(text, (int)(colon - text));
}

static char *shape_adverb_name(JVal *node)
{
    const char *kind;
    if (node == 0 || node->kind != J_OBJ) return xstrdup("");
    kind = jget_str(node, "kind");
    if (strcmp(kind, "Bare") == 0) return shape_before_colon(jget_str(node, "text"));
    if (strcmp(kind, "String") == 0) return shape_before_colon(jget_str(node, "value"));
    if (strcmp(kind, "Number") == 0) {
        JVal *v = jget(node, "value");
        char buf[64];
        snprintf(buf, sizeof(buf), "%lld", v != 0 ? v->num : 0);
        return shape_before_colon(buf);
    }
    return xstrdup("");
}

static JVal *shape_adverbs(JVal *post)
{
    JVal *arr = jarr();
    char **names = 0;
    int n = 0;
    int cap = 0;
    int i;
    int j;
    int k;
    if (post == 0) return arr;
    for (i = 0; i < post->len; i++) {
        JVal *item = post->items[i];
        JVal *items;
        if (strcmp(jget_str(item, "kind"), "Adverb") != 0) continue;
        items = jget(item, "items");
        if (items == 0) continue;
        for (j = 0; j < items->len; j++) {
            char *name = shape_adverb_name(items->items[j]);
            int seen = 0;
            for (k = 0; k < n; k++) {
                if (strcmp(names[k], name) == 0) {
                    seen = 1;
                    break;
                }
            }
            if (!seen) {
                if (n >= cap) {
                    cap = cap ? cap * 2 : 4;
                    names = (char **)xrealloc(names, sizeof(char *) * (size_t)cap);
                }
                names[n++] = name;
            }
        }
    }
    for (i = 0; i < n; i++) {
        for (j = i + 1; j < n; j++) {
            if (strcmp(names[i], names[j]) > 0) {
                char *tmp = names[i];
                names[i] = names[j];
                names[j] = tmp;
            }
        }
    }
    for (i = 0; i < n; i++) jpush(arr, jstr(names[i]));
    return arr;
}

pub JVal *shape_of_call(JVal *call, int template_side)
{
    JVal *o = jobj();
    JVal *preps = jarr();
    JVal *post = jget(call, "post");
    int i;
    jput(o, "verb", jstr(jget_str(call, "verb")));
    jput(o, "subject", shape_slot(jget(call, "subject"), template_side));
    jput(o, "object", shape_slot(jget(call, "object"), template_side));
    if (post != 0) {
        for (i = 0; i < post->len; i++) {
            JVal *item = post->items[i];
            JVal *p;
            if (strcmp(jget_str(item, "kind"), "PrepPhrase") != 0) continue;
            p = jobj();
            jput(p, "prep", jstr(jget_str(item, "prep")));
            jput(p, "object", shape_slot(jget(item, "object"), template_side));
            jpush(preps, p);
        }
    }
    jput(o, "preps", preps);
    jput(o, "adverbs", shape_adverbs(post));
    return o;
}

static int shape_slot_accepts(JVal *def_slot, JVal *call_slot)
{
    const char *dr = jget_str(def_slot, "role");
    const char *cr = jget_str(call_slot, "role");
    if (strcmp(dr, "none") == 0) return strcmp(cr, "none") == 0;
    if (strcmp(dr, "const") == 0) {
        return strcmp(cr, "const") == 0 &&
               strcmp(jget_str(def_slot, "value"), jget_str(call_slot, "value")) == 0;
    }
    return strcmp(cr, "none") != 0;
}

/* 第 index 个介宾的参数位是否带默认值（可整段省略）。 */
pub int shape_prep_optional(JVal *definition, int index)
{
    JVal *tmpl = jget(definition, "template");
    JVal *post;
    int i;
    int seen = 0;
    if (tmpl == 0 || tmpl->len == 0) return 0;
    post = jget(tmpl->items[0], "post");
    if (post == 0) return 0;
    for (i = 0; i < post->len; i++) {
        JVal *item = post->items[i];
        if (strcmp(jget_str(item, "kind"), "PrepPhrase") != 0) continue;
        if (seen == index) {
            return strcmp(jget_str(jget(item, "object"), "kind"), "Default") == 0;
        }
        seen++;
    }
    return 0;
}

static int shape_subsequence(JVal *needle, JVal *haystack)
{
    int pos = 0;
    int i;
    for (i = 0; i < haystack->len && pos < needle->len; i++) {
        if (strcmp(jget_str(needle->items[pos], "prep"),
                   jget_str(haystack->items[i], "prep")) == 0) {
            pos++;
        }
    }
    return pos == needle->len;
}

/* 错误 Hint 用的一行形状文本；不含参数名。 */
static void shape_desc_slot(JVal *slot, char *buf, size_t n)
{
    const char *role = jget_str(slot, "role");
    if (strcmp(role, "none") == 0) snprintf(buf, n, "-");
    else if (strcmp(role, "param") == 0) snprintf(buf, n, "$?");
    else if (strcmp(role, "const") == 0) {
        snprintf(buf, n, "'%s'", jget_str(slot, "value"));
    } else {
        snprintf(buf, n, "$");
    }
}

pub char *shape_describe(JVal *shape)
{
    char buf[1024];
    char tmp[256];
    JVal *preps;
    JVal *adverbs;
    int off = 0;
    int i;
    buf[0] = 0;
    if (strcmp(jget_str(jget(shape, "subject"), "role"), "none") != 0) {
        shape_desc_slot(jget(shape, "subject"), tmp, sizeof(tmp));
        off += snprintf(buf + off, sizeof(buf) - (size_t)off, "%s ", tmp);
    }
    off += snprintf(buf + off, sizeof(buf) - (size_t)off, "<%s>",
                    jget_str(shape, "verb"));
    shape_desc_slot(jget(shape, "object"), tmp, sizeof(tmp));
    off += snprintf(buf + off, sizeof(buf) - (size_t)off, " %s", tmp);
    preps = jget(shape, "preps");
    if (preps != 0) {
        for (i = 0; i < preps->len && off < (int)sizeof(buf) - 1; i++) {
            shape_desc_slot(jget(preps->items[i], "object"), tmp, sizeof(tmp));
            off += snprintf(buf + off, sizeof(buf) - (size_t)off, " [%s] %s",
                            jget_str(preps->items[i], "prep"), tmp);
        }
    }
    adverbs = jget(shape, "adverbs");
    if (adverbs != 0 && adverbs->len > 0) {
        off += snprintf(buf + off, sizeof(buf) - (size_t)off, " (");
        for (i = 0; i < adverbs->len && off < (int)sizeof(buf) - 1; i++) {
            off += snprintf(buf + off, sizeof(buf) - (size_t)off, "%s%s",
                            i == 0 ? "" : ",", adverbs->items[i]->str);
        }
        off += snprintf(buf + off, sizeof(buf) - (size_t)off, ")");
    }
    return xstrdup(buf);
}

/* 0 = 无候选，1 = 精确相等，2 = 只有参数位个数/省略不符。 */
pub int shape_classify(JVal *definition, JVal *call_shape)
{
    JVal *def_shape = jget(definition, "shape");
    JVal *def_preps = jget(def_shape, "preps");
    JVal *call_preps = jget(call_shape, "preps");
    int status = 1;
    int i;
    if (strcmp(jget_str(def_shape, "verb"), jget_str(call_shape, "verb")) != 0) {
        return 0;
    }
    if (!shape_slot_accepts(jget(def_shape, "subject"),
                            jget(call_shape, "subject"))) {
        return 0;
    }
    if (!shape_slot_accepts(jget(def_shape, "object"),
                            jget(call_shape, "object"))) {
        return 0;
    }
    if (!jval_equal(jget(def_shape, "adverbs"), jget(call_shape, "adverbs"))) {
        return 0;
    }
    if (call_preps->len > def_preps->len) return 0;
    {
        int prefix = 1;
        for (i = 0; i < call_preps->len; i++) {
            if (strcmp(jget_str(call_preps->items[i], "prep"),
                       jget_str(def_preps->items[i], "prep")) != 0) {
                prefix = 0;
                break;
            }
        }
        if (prefix) {
            for (i = call_preps->len; i < def_preps->len; i++) {
                if (!shape_prep_optional(definition, i)) {
                    status = 2;
                    break;
                }
            }
        } else if (shape_subsequence(call_preps, def_preps)) {
            status = 2;
        } else {
            return 0;
        }
    }
    for (i = 0; i < call_preps->len; i++) {
        if (!shape_slot_accepts(jget(def_preps->items[i], "object"),
                                jget(call_preps->items[i], "object"))) {
            return 0;
        }
    }
    return status;
}

static void jwrite_string(FILE *out, const char *s)
{
    const unsigned char *p = (const unsigned char *)s;
    fputc('"', out);
    while (*p) {
        unsigned char c = *p;
        switch (c) {
        case '"': fputs("\\\"", out); break;
        case '\\': fputs("\\\\", out); break;
        case '\b': fputs("\\b", out); break;
        case '\f': fputs("\\f", out); break;
        case '\n': fputs("\\n", out); break;
        case '\r': fputs("\\r", out); break;
        case '\t': fputs("\\t", out); break;
        default:
            if (c < 0x20) {
                fprintf(out, "\\u%04x", (unsigned)c);
            } else {
                fputc((int)c, out);
            }
        }
        p++;
    }
    fputc('"', out);
}

/* 只读的伪宿主/能力清单 JSON。标准 JSON 子集：对象/数组/字符串/
   整数/true/false/null。递归下降，深度由输入自身限制。
   PH-19 从 eval 上移到 common：能力清单与 fakes 都要读 JSON。 */
pub JVal *json_parse(const char *s, int *pos)
{
    JVal *v = 0;
    char c;
    int i;
    while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
           s[*pos] == '\r') {
        (*pos)++;
    }
    c = s[*pos];
    if (c == '{') {
        v = jobj();
        (*pos)++;
        for (;;) {
            JVal *key;
            JVal *val;
            while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
                   s[*pos] == '\r') {
                (*pos)++;
            }
            if (s[*pos] == '}') {
                (*pos)++;
                return v;
            }
            key = json_parse(s, pos);
            while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
                   s[*pos] == '\r') {
                (*pos)++;
            }
            if (s[*pos] == ':') (*pos)++;
            val = json_parse(s, pos);
            jput(v, key->str, val);
            while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
                   s[*pos] == '\r') {
                (*pos)++;
            }
            if (s[*pos] == ',') {
                (*pos)++;
                continue;
            }
            if (s[*pos] == '}') {
                (*pos)++;
                return v;
            }
            return v;
        }
    }
    if (c == '[') {
        v = jarr();
        (*pos)++;
        for (;;) {
            while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
                   s[*pos] == '\r') {
                (*pos)++;
            }
            if (s[*pos] == ']') {
                (*pos)++;
                return v;
            }
            jpush(v, json_parse(s, pos));
            while (s[*pos] == ' ' || s[*pos] == '\t' || s[*pos] == '\n' ||
                   s[*pos] == '\r') {
                (*pos)++;
            }
            if (s[*pos] == ',') {
                (*pos)++;
                continue;
            }
            if (s[*pos] == ']') {
                (*pos)++;
                return v;
            }
            return v;
        }
    }
    if (c == '"') {
        int cap = 32;
        int len = 0;
        char *buf = (char *)xmalloc((size_t)cap);
        (*pos)++;
        while (s[*pos] && s[*pos] != '"') {
            char ch = s[*pos];
            if (ch == '\\') {
                (*pos)++;
                ch = s[*pos];
                if (ch == 'n') ch = '\n';
                else if (ch == 't') ch = '\t';
                else if (ch == 'r') ch = '\r';
                else if (ch == 'b') ch = '\b';
                else if (ch == 'f') ch = '\f';
                else if (ch == 'u') {
                    ch = '?';
                    for (i = 0; i < 4 && s[*pos + 1 + i]; i++) (*pos)++;
                }
            }
            if (len + 1 >= cap) {
                cap *= 2;
                buf = (char *)xrealloc(buf, (size_t)cap);
            }
            buf[len++] = ch;
            if (s[*pos]) (*pos)++;
        }
        if (s[*pos] == '"') (*pos)++;
        v = jstrn(buf, len);
        free(buf);
        return v;
    }
    if (strncmp(s + *pos, "true", 4) == 0) {
        *pos += 4;
        return jbool(1);
    }
    if (strncmp(s + *pos, "false", 5) == 0) {
        *pos += 5;
        return jbool(0);
    }
    if (strncmp(s + *pos, "null", 4) == 0) {
        *pos += 4;
        return jnull();
    }
    {
        long long num = 0;
        int neg = 0;
        if (s[*pos] == '-') {
            neg = 1;
            (*pos)++;
        }
        while (is_digit(s[*pos])) {
            num = num * 10 + (s[*pos] - '0');
            (*pos)++;
        }
        return jint(neg ? -num : num);
    }
}

pub char *xbase64(const char *data, int n)
{
    static const char *alphabet =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    const unsigned char *raw = (const unsigned char *)data;
    int cap = ((n + 2) / 3) * 4 + 1;
    char *out = (char *)xmalloc((size_t)cap);
    int i;
    int pos = 0;
    for (i = 0; i + 2 < n; i += 3) {
        unsigned int v = ((unsigned)raw[i] << 16) |
                         ((unsigned)raw[i + 1] << 8) |
                         (unsigned)raw[i + 2];
        out[pos++] = alphabet[(v >> 18) & 63];
        out[pos++] = alphabet[(v >> 12) & 63];
        out[pos++] = alphabet[(v >> 6) & 63];
        out[pos++] = alphabet[v & 63];
    }
    if (i < n) {
        unsigned int v = (unsigned)raw[i] << 16;
        if (i + 1 < n) v |= (unsigned)raw[i + 1] << 8;
        out[pos++] = alphabet[(v >> 18) & 63];
        out[pos++] = alphabet[(v >> 12) & 63];
        out[pos++] = i + 1 < n ? alphabet[(v >> 6) & 63] : '=';
        out[pos++] = '=';
    }
    out[pos] = 0;
    return out;
}

pub char *xb64decode(const char *s, int *out_len)
{
    int n = (int)strlen(s);
    char *out = (char *)xmalloc((size_t)n + 1);
    int pos = 0;
    int acc = 0;
    int bits = 0;
    int i;
    for (i = 0; i < n; i++) {
        char c = s[i];
        int v;
        if (c >= 'A' && c <= 'Z') v = c - 'A';
        else if (c >= 'a' && c <= 'z') v = c - 'a' + 26;
        else if (c >= '0' && c <= '9') v = c - '0' + 52;
        else if (c == '+') v = 62;
        else if (c == '/') v = 63;
        else continue;
        acc = (acc << 6) | v;
        bits += 6;
        if (bits >= 8) {
            bits -= 8;
            out[pos++] = (char)((acc >> bits) & 0xFF);
        }
    }
    out[pos] = 0;
    *out_len = pos;
    return out;
}

pub void jfmt_double(char *buf, size_t cap, double value)
{
    char *dot;
    char *end;
    snprintf(buf, cap, "%.3f", value);
    dot = strchr(buf, '.');
    if (dot == 0) return;
    end = buf + strlen(buf) - 1;
    while (end > dot + 1 && *end == '0') {
        *end = 0;
        end--;
    }
}

/* ``Bytes.data.decode("utf-8", "replace")`` 的近似：坏字节逐字节替换。
   （Python 对截断多字节可能合并成一个 U+FFFD；未覆盖语料，见 PH-19 §9 #8。） */
pub char *jbytes_text(JVal *v)
{
    const unsigned char *s = (const unsigned char *)v->str;
    int n = (int)v->num;
    int i = 0;
    int cap = n + 8;
    int len = 0;
    char *out = (char *)xmalloc((size_t)cap);
    while (i < n) {
        unsigned char c = s[i];
        int need;
        int valid = 1;
        int k;
        if (c < 0x80) need = 0;
        else if ((c & 0xE0) == 0xC0) need = 1;
        else if ((c & 0xF0) == 0xE0) need = 2;
        else if ((c & 0xF8) == 0xF0) need = 3;
        else {
            need = 0;
            valid = 0;
        }
        if (valid) {
            if (i + need >= n) {
                valid = 0;
            } else {
                for (k = 1; k <= need; k++) {
                    if ((s[i + k] & 0xC0) != 0x80) {
                        valid = 0;
                        break;
                    }
                }
            }
        }
        if (len + 5 > cap) {
            cap *= 2;
            out = (char *)xrealloc(out, (size_t)cap);
        }
        if (valid) {
            memcpy(out + len, s + i, (size_t)(need + 1));
            len += need + 1;
            i += need + 1;
        } else {
            memcpy(out + len, "\xEF\xBF\xBD", 3);
            len += 3;
            i++;
        }
    }
    out[len] = 0;
    return out;
}

pub void jdump(FILE *out, JVal *v)
{
    int i;
    if (v == 0) {
        fputs("null", out);
        return;
    }
    switch (v->kind) {
    case J_NULL: fputs("null", out); break;
    case J_BOOL: fputs(v->boolean ? "true" : "false", out); break;
    case J_INT: fprintf(out, "%lld", v->num); break;
    case J_FLOAT: {
        char num[64];
        jfmt_double(num, sizeof(num), v->dbl);
        fputs(num, out);
        break;
    }
    case J_STR: jwrite_string(out, v->str); break;
    case J_BYTES: {
        char *raw = xbase64(v->str, (int)v->num);
        fputs("{\"$bytes\":", out);
        jwrite_string(out, raw);
        fputc('}', out);
        free(raw);
        break;
    }
    case J_ARR:
        fputc('[', out);
        for (i = 0; i < v->len; i++) {
            if (i) fputc(',', out);
            jdump(out, v->items[i]);
        }
        fputc(']', out);
        break;
    case J_OBJ:
        fputc('{', out);
        for (i = 0; i < v->len; i++) {
            if (i) fputc(',', out);
            jwrite_string(out, v->keys[i]);
            fputc(':', out);
            jdump(out, v->items[i]);
        }
        fputc('}', out);
        break;
    }
}

/* A trait is used for the one place where the same call site has to write to
   stdout for success and to a diagnostic envelope on failure. */
pub trait Emitter {
    void emit(const char *field, JVal *value);
}

pub struct StdoutEmitter {
    int failed;
} use Emitter;

/* 跨层（--lib 之外）的单元不认识 Emitter，`out.emit()` 会落到未初始化的
   `__emitter_vptr` 上；真正写输出的逻辑因此放在这个自由函数里，trait 方法只转发。 */
pub void emitter_emit(StdoutEmitter *self, const char *field, JVal *value)
{
    JVal *root = jobj();
    if (field == 0) {
        JVal *err = jobj();
        jput(err, "stage", jstr(g_diag.stage));
        jput(err, "code", jstr(g_diag.code));
        jput(err, "line", jint(g_diag.line));
        jput(err, "col", jint(g_diag.col));
        jput(err, "message", jstr(g_diag.message));
        if (g_has_hint) jput(err, "hint", jstr(g_hint));
        jput(root, "error", err);
        self->failed = 1;
    } else {
        jput(root, field, value);
    }
    jdump(stdout, root);
    fputc('\n', stdout);
    fflush(stdout);
}

impl Emitter for StdoutEmitter {
    void emit(const char *field, JVal *value) {
        emitter_emit(self, field, value);
    }
}
