// loader — RILL 0.1.0 CT 多单元版（见 docs/phases/pending/ct-multiunit.md）

import common::common;

import lexer::lexer;
import parser::parser;

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>


/* ------------------------------------------------------------------ */
/* load-time checks (token stream)                                      */
/* ------------------------------------------------------------------ */

/* PH-15：加载期只看 token，不给 AST 加 span。Token 自带 line/col，错误位置
   与 Python 的 loader 一致（调用点取 `@`，动词取 VerbCall 的起点）。 */
typedef struct {
    char *name;
    char **params;
    unsigned char *has_default;
    int nparams;
    int capparams;
    int line;
    int col;
} LoadFn;

typedef struct {
    char *short_name;
    char marker;
    char *long_name;
} LoadMap;

/* Python loader：SHELL_VERBS == AGENT_VERBS，profile 不改变动词集。 */
static const char *LOAD_VERBS[] = {
    "read", "write", "parse", "send", "search", "replace", "contains",
    "review", "env", "run"
};

pub void load_scan(Lexer *lx, JVal *warnings)
{
    Token *toks = lx->toks;
    int ntok = lx->ntoks;
    LoadMap *maps = 0;
    int nmaps = 0;
    int capmaps = 0;
    LoadFn *fns = 0;
    int nfns = 0;
    int capfns = 0;
    int *defs = 0;
    int ndefs = 0;
    int capdefs = 0;
    int i;
    int j;
    int k;
    int m;

    /* 第一遍：//map{} 块。同块重复短词是加载错误；表供动词别名解析。 */
    for (i = 0; i < ntok; i++) {
        int first;
        if (toks[i].kind != TK_MAP_HEADER) continue;
        first = nmaps;
        i++;
        for (; i < ntok && toks[i].kind != TK_RBRACE; i++) {
            if (toks[i].kind != TK_MAP_SHORT) continue;
            for (k = first; k < nmaps; k++) {
                if (strcmp(maps[k].short_name, toks[i].text) == 0) {
                    fail("load", "E-LOAD-MAP-DUP-SHORT", toks[i].line,
                         toks[i].col,
                         "短词 '%s' 在同一 //map{} 内重复定义", toks[i].text);
                }
            }
            if (nmaps >= capmaps) {
                capmaps = capmaps ? capmaps * 2 : 8;
                maps = (LoadMap *)xrealloc(maps,
                                           sizeof(LoadMap) * (size_t)capmaps);
            }
            maps[nmaps].short_name = xstrdup(toks[i].text);
            maps[nmaps].marker = toks[i + 1].text[0];
            maps[nmaps].long_name = xstrdup(toks[i + 2].text);
            nmaps++;
            i += 2;
        }
    }

    /* 第二遍：//fn{}。同名以首个定义为准（Python setdefault 语义）。 */
    for (i = 0; i < ntok; i++) {
        if (toks[i].kind != TK_FN_HEADER) continue;
        i++;
        for (;;) {
            int fi;
            int first_def;
            if (i >= ntok) break;
            if (toks[i].kind == TK_RBRACE) break;
            if (toks[i].kind != TK_AT) {
                i++;
                continue;
            }
            if (ndefs >= capdefs) {
                capdefs = capdefs ? capdefs * 2 : 8;
                defs = (int *)xrealloc(defs,
                                       sizeof(int) * (size_t)capdefs);
            }
            defs[ndefs++] = i;
            fi = -1;
            for (k = 0; k < nfns; k++) {
                if (strcmp(fns[k].name, toks[i + 1].text) == 0) {
                    fi = k;
                    break;
                }
            }
            first_def = 0;
            if (fi < 0) {
                if (nfns >= capfns) {
                    capfns = capfns ? capfns * 2 : 8;
                    fns = (LoadFn *)xrealloc(fns,
                                             sizeof(LoadFn) * (size_t)capfns);
                }
                memset(&fns[nfns], 0, sizeof(LoadFn));
                fns[nfns].name = xstrdup(toks[i + 1].text);
                fns[nfns].line = toks[i].line;
                fns[nfns].col = toks[i].col;
                fi = nfns++;
                first_def = 1;
            }
            j = i + 2;
            while (j < ntok && toks[j].kind != TK_LBRACE) {
                if (toks[j].kind == TK_VARIABLE) {
                    int has_def =
                        (j + 1 < ntok && toks[j + 1].kind == TK_QUESTION);
                    int pi = -1;
                    for (k = 0; k < fns[fi].nparams; k++) {
                        if (strcmp(fns[fi].params[k], toks[j].text) == 0) {
                            pi = k;
                            break;
                        }
                    }
                    if (pi < 0 && first_def) {
                        if (fns[fi].nparams >= fns[fi].capparams) {
                            fns[fi].capparams = fns[fi].capparams
                                                    ? fns[fi].capparams * 2
                                                    : 4;
                            fns[fi].params = (char **)xrealloc(
                                fns[fi].params,
                                sizeof(char *) * (size_t)fns[fi].capparams);
                            fns[fi].has_default = (unsigned char *)xrealloc(
                                fns[fi].has_default,
                                sizeof(unsigned char) *
                                    (size_t)fns[fi].capparams);
                        }
                        pi = fns[fi].nparams++;
                        fns[fi].params[pi] = xstrdup(toks[j].text);
                        fns[fi].has_default[pi] = 0;
                    }
                    if (pi >= 0 && has_def) fns[fi].has_default[pi] = 1;
                    if (has_def) {
                        /* 默认值里的 $变量不算模板参数（Python 不递归 Default）。 */
                        j += 2;
                        if (j < ntok && p_is_word_kind(toks[j].kind)) {
                            j++;
                            while (j < ntok &&
                                   p_adjacent(&toks[j - 1], &toks[j])) {
                                j++;
                            }
                        }
                        continue;
                    }
                }
                j++;
            }
            if (j < ntok && toks[j].kind == TK_LBRACE) {
                int depth = 1;
                j++;
                while (j < ntok && depth > 0) {
                    if (toks[j].kind == TK_LBRACE) depth++;
                    else if (toks[j].kind == TK_RBRACE) depth--;
                    j++;
                }
            }
            i = j;
        }
    }

    /* §4.18：默认值只允许尾部连续省略。 */
    for (k = 0; k < nfns; k++) {
        int tail = 0;
        for (m = 0; m < fns[k].nparams; m++) {
            if (fns[k].has_default[m]) {
                tail = 1;
            } else if (tail) {
                fail("load", "E-LOAD-FN-DEFAULT-NOT-TAIL", fns[k].line,
                     fns[k].col,
                     "函数 '%s' 的默认值只能出现在尾部；$%s 缺少默认值",
                     fns[k].name, fns[k].params[m]);
            }
        }
    }

    /* 第三遍：文档顺序。调用名/实参、动词、W-01 与 Python 的 AST 遍历同序。 */
    for (i = 0; i < ntok; i++) {
        TokKind kind = toks[i].kind;
        if (kind == TK_AT) {
            const char *name;
            int given = 0;
            int fi = -1;
            int missing = 0;
            for (k = 0; k < ndefs; k++) {
                if (defs[k] == i) break;
            }
            if (k < ndefs) continue; /* FnDef 头不是 CallStmt */
            name = toks[i + 1].text;
            j = i + 2;
            while (j < ntok && p_is_word_kind(toks[j].kind)) {
                given++;
                j++;
                while (j < ntok && p_adjacent(&toks[j - 1], &toks[j])) j++;
            }
            for (k = 0; k < nfns; k++) {
                if (strcmp(fns[k].name, name) == 0) {
                    fi = k;
                    break;
                }
            }
            if (fi < 0) {
                fail("load", "E-LOAD-FN-UNDECLARED", toks[i].line, toks[i].col,
                     "未声明的函数 '%s'；只能调用 //fn{} 内定义的名字", name);
            }
            if (given < fns[fi].nparams) {
                for (m = given; m < fns[fi].nparams; m++) {
                    if (!fns[fi].has_default[m]) missing = 1;
                }
            }
            if (given > fns[fi].nparams || missing) {
                fail("load", "E-LOAD-FN-ARITY", toks[i].line, toks[i].col,
                     "函数 '%s' 需要 %d 个实参，实际 %d 个",
                     fns[fi].name, fns[fi].nparams, given);
            }
        } else if (kind == TK_VERB) {
            const char *verb = toks[i].text;
            int start = i;
            int known = 0;
            for (k = 0; k < nmaps; k++) {
                if (maps[k].marker == '<' &&
                    strcmp(maps[k].short_name, verb) == 0) {
                    verb = maps[k].long_name;
                    break;
                }
            }
            for (k = 0; k < (int)(sizeof(LOAD_VERBS) / sizeof(LOAD_VERBS[0]));
                 k++) {
                if (strcmp(LOAD_VERBS[k], verb) == 0) {
                    known = 1;
                    break;
                }
            }
            if (!known) {
                /* VerbCall 的 span 从主语开始（若有）。 */
                if (i > 0 && p_is_word_kind(toks[i - 1].kind)) {
                    start = i - 1;
                    while (start > 0 &&
                           p_is_word_kind(toks[start - 1].kind) &&
                           p_adjacent(&toks[start - 1], &toks[start])) {
                        start--;
                    }
                    if (start >= 2 && toks[start - 1].kind == TK_QUESTION &&
                        toks[start - 2].kind == TK_VARIABLE) {
                        start -= 2;
                    }
                }
                fail("load", "E-LOAD-VERB-UNKNOWN", toks[start].line,
                     toks[start].col,
                     "未知动词 '%s'；0.1.0 动词集见 PH-4 卡 §8", verb);
            }
        } else if (kind == TK_KEYWORD && strcmp(toks[i].text, "each") == 0 &&
                   i + 5 < ntok && toks[i + 1].kind == TK_VARIABLE &&
                   toks[i + 2].kind == TK_LBRACKET &&
                   toks[i + 4].kind == TK_RBRACKET) {
            /* §4.20 W-01：只提示，不影响退出码。 */
            Token *src = &toks[i + 5];
            Token *nxt = (i + 6 < ntok) ? &toks[i + 6] : &toks[ntok - 1];
            if (src->kind == TK_BARE && nxt->kind != TK_VERB &&
                !p_adjacent(src, nxt)) {
                JVal *w = jobj();
                char msg[512];
                snprintf(msg, sizeof(msg),
                         "裸词 `%s` 按字符串处理，若意图是变量请写 `$%s`",
                         src->text, src->text);
                jput(w, "code", jstr("W-01"));
                jput(w, "line", jint(src->line));
                jput(w, "col", jint(src->col));
                jput(w, "message", jstr(msg));
                jpush(warnings, w);
            }
        }
    }
}

/* ------------------------------------------------------------------ */
/* file input                                                          */
/* ------------------------------------------------------------------ */

pub char *read_source(const char *path, int *out_len)
{
    FILE *f = fopen(path, "rb");
    long size;
    char *raw;
    char *norm;
    int n;
    int i;
    int j;

    if (f == 0) return 0;
    if (fseek(f, 0, SEEK_END) != 0) {
        fclose(f);
        return 0;
    }
    size = ftell(f);
    if (size < 0) {
        fclose(f);
        return 0;
    }
    if (fseek(f, 0, SEEK_SET) != 0) {
        fclose(f);
        return 0;
    }
    raw = (char *)xmalloc((size_t)size + 1);
    n = (int)fread(raw, 1, (size_t)size, f);
    fclose(f);
    raw[n] = 0;

    norm = (char *)xmalloc((size_t)n + 1);
    j = 0;
    for (i = 0; i < n; i++) {
        if (raw[i] == '\r') {
            if (i + 1 < n && raw[i + 1] == '\n') i++;
            norm[j++] = '\n';
        } else {
            norm[j++] = raw[i];
        }
    }
    norm[j] = 0;
    free(raw);
    *out_len = j;
    return norm;
}
