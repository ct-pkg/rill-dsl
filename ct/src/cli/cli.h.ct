#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <unistd.h>

#define LOAD_DEFAULT_ERROR "RILL DSL ERROR"
#define usage_fail(...) fail("cli", "E_USAGE", 0, 0, __VA_ARGS__)

/* ------------------------------------------------------------------ */
/* CLI                                                                 */
/* ------------------------------------------------------------------ */

pub int cmd_tokenize(int argc, char **argv)
{
    const char *path = 0;
    int count = 0;
    int i;
    int n = 0;
    char *source;
    Lexer lexer;
    JVal *tokens;
    StdoutEmitter out;

    for (i = 0; i < argc; i++) {
        if (argv[i][0] == '-') continue;
        path = argv[i];
        count++;
    }
    if (count != 1) usage_fail("tokenize 需要且只需要一个源文件参数");

    source = read_source(path, &n);
    if (source == 0) usage_fail("无法读取 %s", path);

    memset(&lexer, 0, sizeof(lexer));
    lexer.src = source;
    lexer.n = n;
    lexer.line = 1;
    lexer.col = 1;
    lexer_run(&lexer);

    tokens = jarr();
    for (i = 0; i < lexer.ntoks; i++) {
        Token *t = &lexer.toks[i];
        JVal *o = jobj();
        jput(o, "kind", jstr(tok_name((int)t->kind)));
        jput(o, "text", jstr(t->text));
        jput(o, "line", jint(t->line));
        jput(o, "col", jint(t->col));
        jpush(tokens, o);
    }

    out.failed = 0;
    emitter_emit(&out, "tokens", tokens);
    return 0;
}

pub int cmd_parse(int argc, char **argv)
{
    const char *profile = "shell";
    const char *path = 0;
    int dump = 0;
    int count = 0;
    int i = 0;
    int n = 0;
    char *source;
    Lexer lexer;
    Parser parser;
    JVal *tree;
    StdoutEmitter out;

    while (i < argc) {
        const char *arg = argv[i];
        if (strcmp(arg, "--dump-ast") == 0) {
            dump = 1;
        } else if (strcmp(arg, "--profile") == 0) {
            i++;
            if (i >= argc) usage_fail("--profile 缺参数");
            profile = argv[i];
        } else if (strncmp(arg, "--profile=", 10) == 0) {
            profile = arg + 10;
        } else if (arg[0] == '-') {
            usage_fail("parse 不认识的参数 %s", arg);
        } else {
            path = arg;
            count++;
        }
        i++;
    }
    if (count != 1) usage_fail("parse 需要且只需要一个源文件参数");
    if (!dump) usage_fail("parse 目前只支持 --dump-ast");
    if (strcmp(profile, "shell") != 0 && strcmp(profile, "agent") != 0) {
        usage_fail("未知 profile %s（只允许 shell / agent）", profile);
    }

    source = read_source(path, &n);
    if (source == 0) usage_fail("无法读取 %s", path);

    memset(&lexer, 0, sizeof(lexer));
    lexer.src = source;
    lexer.n = n;
    lexer.line = 1;
    lexer.col = 1;
    lexer_run(&lexer);

    memset(&parser, 0, sizeof(parser));
    parser.toks = lexer.toks;
    parser.ntok = lexer.ntoks;
    tree = p_parse_program(&parser);

    out.failed = 0;
    emitter_emit(&out, "ast", tree);
    return 0;
}

pub int cmd_check(int argc, char **argv)
{
    const char *profile = "shell";
    const char *path = 0;
    int count = 0;
    int i = 0;
    int n = 0;
    char *source;
    Lexer lexer;
    Parser parser;
    JVal *program;
    JVal *warnings;
    StdoutEmitter out;

    while (i < argc) {
        const char *arg = argv[i];
        if (strcmp(arg, "--profile") == 0) {
            i++;
            if (i >= argc) usage_fail("--profile 缺参数");
            profile = argv[i];
        } else if (strncmp(arg, "--profile=", 10) == 0) {
            profile = arg + 10;
        } else if (arg[0] == '-') {
            usage_fail("check 不认识的参数 %s", arg);
        } else {
            path = arg;
            count++;
        }
        i++;
    }
    if (count != 1) usage_fail("check 需要且只需要一个源文件参数");
    if (strcmp(profile, "shell") != 0 && strcmp(profile, "agent") != 0) {
        usage_fail("未知 profile %s（只允许 shell / agent）", profile);
    }

    source = read_source(path, &n);
    if (source == 0) usage_fail("无法读取 %s", path);

    memset(&lexer, 0, sizeof(lexer));
    lexer.src = source;
    lexer.n = n;
    lexer.line = 1;
    lexer.col = 1;
    lexer_run(&lexer);

    /* 先走 parser：词法/语法错误仍报各自阶段，加载期不抢层。 */
    memset(&parser, 0, sizeof(parser));
    parser.toks = lexer.toks;
    parser.ntok = lexer.ntoks;
    program = p_parse_program(&parser);

    warnings = jarr();
    load_scan(&lexer, warnings);
    load_shapes(program);

    out.failed = 0;
    emitter_emit(&out, "warnings", warnings);
    return 0;
}

pub int cmd_run(int argc, char **argv)
{
    const char *profile = "shell";
    const char *path = 0;
    const char *fakes_path = 0;
    const char *host_profile_path = 0;
    int count = 0;
    int i = 0;
    int n = 0;
    int fn = 0;
    int pos = 0;
    int code;
    char *source;
    char *fake_src = 0;
    Lexer lexer;
    Parser parser;
    JVal *program;
    JVal *doc;
    JVal *tools = 0;
    JVal *body;
    JVal *root;
    JVal *principal;
    JVal *host;
    ShellHost *shell = 0;
    AgentHost *agent = 0;
    int agent_mode = 0;
    char cwd[4096];
    Eval ev;
    EOut out;

    while (i < argc) {
        const char *arg = argv[i];
        if (strcmp(arg, "--profile") == 0) {
            i++;
            if (i >= argc) usage_fail("--profile 缺参数");
            profile = argv[i];
        } else if (strncmp(arg, "--profile=", 10) == 0) {
            profile = arg + 10;
        } else if (strcmp(arg, "--fakes") == 0) {
            i++;
            if (i >= argc) usage_fail("--fakes 缺参数");
            fakes_path = argv[i];
        } else if (strncmp(arg, "--fakes=", 8) == 0) {
            fakes_path = arg + 8;
        } else if (strcmp(arg, "--host-profile") == 0) {
            i++;
            if (i >= argc) usage_fail("--host-profile 缺参数");
            host_profile_path = argv[i];
        } else if (strncmp(arg, "--host-profile=", 15) == 0) {
            host_profile_path = arg + 15;
        } else if (arg[0] == '-') {
            usage_fail("run 不认识的参数 %s", arg);
        } else {
            path = arg;
            count++;
        }
        i++;
    }
    if (count != 1) usage_fail("run 需要且只需要一个源文件参数");
    if (strcmp(profile, "shell") != 0 && strcmp(profile, "agent") != 0) {
        usage_fail("未知 profile %s（只允许 shell / agent）", profile);
    }
    /* PH-19 落 Shell 宿主，PH-20 落 Agent 宿主；未给 profile 时用各自默认策略。 */
    if (fakes_path == 0 && strcmp(profile, "agent") == 0) agent_mode = 1;
    if (getcwd(cwd, sizeof(cwd)) == 0) snprintf(cwd, sizeof(cwd), "%s", ".");

    source = read_source(path, &n);
    if (source == 0) usage_fail("无法读取 %s", path);
    if (fakes_path != 0) {
        fake_src = read_source(fakes_path, &fn);
        if (fake_src == 0) usage_fail("无法读取 fakes %s", fakes_path);
    }

    memset(&lexer, 0, sizeof(lexer));
    lexer.src = source;
    lexer.n = n;
    lexer.line = 1;
    lexer.col = 1;
    lexer_run(&lexer);

    memset(&parser, 0, sizeof(parser));
    parser.toks = lexer.toks;
    parser.ntok = lexer.ntoks;
    program = p_parse_program(&parser);

    /* 与 Python `run` 一致：map 与函数形状的加载期校验先于求值。 */
    {
        JVal *warnings = jarr();
        load_scan(&lexer, warnings);
        load_shapes(program);
    }

    /* 顺序对齐 Python `_run_verbs`：有 --fakes 时 fake 优先，能力清单不参与。 */
    if (fakes_path != 0) {
        doc = json_parse(fake_src, &pos);
        tools = jget(doc, "tools");
        if (tools == 0 || tools->kind != J_OBJ) {
            fail("run", "E-RUN-FAKES", 0, 0, "fakes 缺少 tools 对象");
        }
    } else if (host_profile_path != 0) {
        if (agent_mode) agent = ag_load_host(host_profile_path, cwd);
        else shell = sh_load_host(host_profile_path);
    } else if (agent_mode) {
        agent = ag_default_host(cwd);
    } else {
        shell = sh_default_host();
    }
    if (agent != 0) ag_validate_program(agent, program);

    ev.program = program;
    ev.tools = tools;
    ev.host = agent != 0 ? ag_ops(agent) : (shell != 0 ? sh_ops(shell) : 0);
    ev.vars = 0;
    eout_success(&out, jnull());
    body = jget(program, "body");
    for (i = 0; i < body->len; i++) {
        out = eval_stmt(&ev, body->items[i], jnull());
        if (out.is_break) {
            if (out.break_target != 0 && out.break_target[0] != 0) {
                eval_set_var(&ev, out.break_target, out.value);
            }
            eout_success(&out, out.value ? out.value : jnull());
            break;
        }
        if (!out.ok) break;
    }

    root = jobj();
    jput(root, "ok", jbool(out.ok));
    jput(root, "value", out.value ? out.value : jnull());
    jput(root, "error",
         out.ok ? jnull() : jstr(out.error ? out.error : LOAD_DEFAULT_ERROR));
    jput(root, "host_meta",
         (out.meta != 0 && out.meta->kind == J_OBJ) ? out.meta : jobj());
    host = jobj();
    principal = jobj();
    if (fakes_path != 0) {
        jput(host, "profile", jstr("fakes"));
        jput(principal, "kind", jstr("test-transport"));
        jput(principal, "name", jstr("--fakes"));
    } else if (agent != 0) {
        jput(host, "profile", jstr("agent"));
        jput(principal, "kind", jstr("role"));
        jput(principal, "name", jstr(ag_role(agent)));
    } else {
        const char *user = getenv("USER");
        jput(host, "profile", jstr("shell"));
        jput(principal, "kind", jstr("os-user"));
        jput(principal, "name", jstr(user != 0 ? user : ""));
    }
    jput(host, "principal", principal);
    jput(root, "host", host);
    jdump(stdout, root);
    fputc('\n', stdout);
    fflush(stdout);
    if (agent != 0) {
        code = ag_exit_code(agent, out.ok);
    } else if (shell != 0) {
        code = sh_exit_code(shell, out.ok);
    } else {
        code = out.ok ? 0 : 1;
    }
    return code;
}

/* fmt 的 stdout 是纯文本，不是 JSON；词法错误仍走 fail 的 JSON 信封。 */
pub int cmd_fmt(int argc, char **argv)
{
    const char *path = 0;
    int display = -1;
    int count = 0;
    int i;
    int n = 0;
    char *source;
    char *text;
    Lexer lexer;

    for (i = 0; i < argc; i++) {
        const char *arg = argv[i];
        if (strcmp(arg, "--compress") == 0) {
            if (display >= 0) usage_fail("fmt 只能选一种格式（--compress / --display）");
            display = 0;
        } else if (strcmp(arg, "--display") == 0) {
            if (display >= 0) usage_fail("fmt 只能选一种格式（--compress / --display）");
            display = 1;
        } else if (arg[0] == '-') {
            usage_fail("fmt 不认识的参数 %s", arg);
        } else {
            path = arg;
            count++;
        }
    }
    if (display < 0) usage_fail("fmt 需要 --compress 或 --display");
    if (count != 1) usage_fail("fmt 需要且只需要一个源文件参数");

    source = read_source(path, &n);
    if (source == 0) usage_fail("无法读取 %s", path);

    memset(&lexer, 0, sizeof(lexer));
    lexer.src = source;
    lexer.n = n;
    lexer.line = 1;
    lexer.col = 1;
    lexer_run(&lexer);

    text = fmt_format(lexer.toks, lexer.ntoks, source, display);
    fputs(text, stdout);
    fflush(stdout);
    return 0;
}
