// formatter — RILL 0.1.0 压缩态/展示态（见 docs/phases/PH-18/card.md）

import common::common;

import lexer::lexer;

#include <stdio.h>
#include <stdlib.h>
#include <string.h>


/*
 * src/rill/formatter.py 是本单元的对照实现：下面每个函数与 Python 里同名
 * 函数一一对应，差异只允许在内存管理与字符串表示，不允许在判定规则上。
 * 形参 display 对应 Python 的 mode == "display"。
 */

/* ------------------------------------------------------------------ */
/* output buffer                                                       */
/* ------------------------------------------------------------------ */

struct FBuf {
    char *s;
    int len;
    int cap;
};

static void fb_init(FBuf *b)
{
    b->cap = 64;
    b->s = (char *)xmalloc((size_t)b->cap);
    b->s[0] = 0;
    b->len = 0;
}

static void fb_room(FBuf *b, int extra)
{
    int need = b->len + extra + 1;
    if (need <= b->cap) return;
    while (b->cap < need) b->cap *= 2;
    b->s = (char *)xrealloc(b->s, (size_t)b->cap);
}

static void fb_putc(FBuf *b, char c)
{
    fb_room(b, 1);
    b->s[b->len++] = c;
    b->s[b->len] = 0;
}

static void fb_putn(FBuf *b, const char *s, int n)
{
    if (n <= 0) return;
    fb_room(b, n);
    memcpy(b->s + b->len, s, (size_t)n);
    b->len += n;
    b->s[b->len] = 0;
}

static void fb_puts(FBuf *b, const char *s) { fb_putn(b, s, (int)strlen(s)); }

/* 把 pre + text + post 拼成一个新串；_render 的一字包装都用它。 */
static char *f_wrap(const char *pre, const char *text, const char *post)
{
    FBuf b;
    fb_init(&b);
    fb_puts(&b, pre);
    fb_puts(&b, text);
    fb_puts(&b, post);
    return b.s;
}

static char *f_join(const char *head, const char *tail)
{
    FBuf b;
    fb_init(&b);
    fb_puts(&b, head);
    fb_puts(&b, tail);
    return b.s;
}

/* ------------------------------------------------------------------ */
/* source lines                                                        */
/* ------------------------------------------------------------------ */

struct FLines {
    const char *src;
    int *starts;
    int *lens;
    int n;
};

static void fl_build(FLines *fl, const char *src)
{
    int n = (int)strlen(src);
    int cap = 16;
    int start = 0;
    int i;

    fl->src = src;
    fl->n = 0;
    fl->starts = (int *)xmalloc(sizeof(int) * (size_t)cap);
    fl->lens = (int *)xmalloc(sizeof(int) * (size_t)cap);
    for (i = 0; i <= n; i++) {
        if (i != n && src[i] != '\n') continue;
        if (fl->n == cap) {
            cap *= 2;
            fl->starts = (int *)xrealloc(fl->starts, sizeof(int) * (size_t)cap);
            fl->lens = (int *)xrealloc(fl->lens, sizeof(int) * (size_t)cap);
        }
        fl->starts[fl->n] = start;
        fl->lens[fl->n] = i - start;
        fl->n++;
        start = i + 1;
    }
}

static const char *fl_line(FLines *fl, int lineno, int *out_len)
{
    if (lineno < 1 || lineno > fl->n) {
        *out_len = 0;
        return "";
    }
    *out_len = fl->lens[lineno - 1];
    return fl->src + fl->starts[lineno - 1];
}

/* Python 的 token.col 是码点下标；取原始行里的字节偏移要反向走一遍。 */
static int fl_cp_to_byte(const char *line, int len, int cp)
{
    int i = 0;
    int count = 0;
    while (i < len && count < cp) {
        i++;
        while (i < len && is_utf8_cont((unsigned char)line[i])) i++;
        count++;
    }
    return i;
}

static int f_cp_len_n(const char *s, int n)
{
    int i;
    int count = 0;
    for (i = 0; i < n; i++) {
        if (!is_utf8_cont((unsigned char)s[i])) count++;
    }
    return count;
}

/* token 在源码里的原始宽度；PD-1 / PD-2 后与 parser 共用 lexer 的 raw_len
   一个口径，不再回扫源码行。 */
static int f_raw_width(FLines *fl, const Token *t)
{
    (void)fl;
    return t->raw_len;
}

static int f_adjacent(FLines *fl, const Token *prev, const Token *cur)
{
    if (prev->line != cur->line) return 0;
    return cur->col == prev->col + f_raw_width(fl, prev);
}

/* ------------------------------------------------------------------ */
/* map entries                                                         */
/* ------------------------------------------------------------------ */

struct FEntry {
    const char *short_word;
    const char *marker;
    const char *long_word;
};

struct FEntries {
    FEntry *items;
    int len;
    int cap;
};

/* 同一文件内首次绑定；后出现的同短词定义不覆盖。 */
static void fe_add(FEntries *e, const char *short_word, const char *marker,
                   const char *long_word)
{
    int i;
    for (i = 0; i < e->len; i++) {
        if (strcmp(e->items[i].short_word, short_word) == 0) return;
    }
    if (e->len == e->cap) {
        e->cap = e->cap ? e->cap * 2 : 8;
        e->items = (FEntry *)xrealloc(e->items, sizeof(FEntry) * (size_t)e->cap);
    }
    e->items[e->len].short_word = short_word;
    e->items[e->len].marker = marker;
    e->items[e->len].long_word = long_word;
    e->len++;
}

static void fe_build(FEntries *e, const Token *toks, int n)
{
    int i = 0;
    e->items = 0;
    e->len = 0;
    e->cap = 0;
    while (i + 2 < n) {
        if (toks[i].kind == TK_MAP_SHORT && toks[i + 1].kind == TK_MAP_MARK &&
            toks[i + 2].kind == TK_MAP_LONG) {
            fe_add(e, toks[i].text, toks[i + 1].text, toks[i + 2].text);
            i += 3;
            continue;
        }
        i++;
    }
}

static FEntry *fe_get(FEntries *e, const char *text)
{
    int i;
    for (i = 0; i < e->len; i++) {
        if (strcmp(e->items[i].short_word, text) == 0) return &e->items[i];
    }
    return 0;
}

static int f_value_marker(const char *marker)
{
    return marker[0] == '\'' || marker[0] == '`';
}

struct FRev {
    const char **longs;
    const char **shorts;
    int len;
    int cap;
};

static void fr_init(FRev *r)
{
    r->longs = 0;
    r->shorts = 0;
    r->len = 0;
    r->cap = 0;
}

static int fr_has(FRev *r, const char *long_word)
{
    int i;
    for (i = 0; i < r->len; i++) {
        if (strcmp(r->longs[i], long_word) == 0) return 1;
    }
    return 0;
}

static void fr_add(FRev *r, const char *long_word, const char *short_word)
{
    if (fr_has(r, long_word)) return;
    if (r->len == r->cap) {
        r->cap = r->cap ? r->cap * 2 : 8;
        r->longs = (const char **)xrealloc(r->longs, sizeof(char *) * (size_t)r->cap);
        r->shorts = (const char **)xrealloc(r->shorts, sizeof(char *) * (size_t)r->cap);
    }
    r->longs[r->len] = long_word;
    r->shorts[r->len] = short_word;
    r->len++;
}

/* 长词优先，避免 alpha/alphabet 互相遮住；等长时保持首次绑定顺序。 */
static void fr_sort_desc(FRev *r)
{
    int i;
    for (i = 1; i < r->len; i++) {
        const char *lw = r->longs[i];
        const char *sw = r->shorts[i];
        int j = i - 1;
        while (j >= 0 && strlen(r->longs[j]) < strlen(lw)) {
            r->longs[j + 1] = r->longs[j];
            r->shorts[j + 1] = r->shorts[j];
            j--;
        }
        r->longs[j + 1] = lw;
        r->shorts[j + 1] = sw;
    }
}

static const char *fr_get(FRev *r, const char *long_word)
{
    int i;
    for (i = 0; i < r->len; i++) {
        if (strcmp(r->longs[i], long_word) == 0) return r->shorts[i];
    }
    return 0;
}

/* ------------------------------------------------------------------ */
/* token rendering                                                     */
/* ------------------------------------------------------------------ */

/* 输出一个回读值不变的字符串字面量；单引号优先。 */
static char *f_quote(const char *text)
{
    FBuf b;
    int i;
    int plain = 1;

    for (i = 0; text[i] != 0; i++) {
        if (text[i] == '\'' || text[i] == '\\' || text[i] == '"') {
            plain = 0;
            break;
        }
    }
    fb_init(&b);
    if (plain) {
        fb_putc(&b, '\'');
        fb_puts(&b, text);
        fb_putc(&b, '\'');
        return b.s;
    }
    fb_putc(&b, '"');
    for (i = 0; text[i] != 0; i++) {
        if (text[i] == '\\' || text[i] == '"') fb_putc(&b, '\\');
        fb_putc(&b, text[i]);
    }
    fb_putc(&b, '"');
    return b.s;
}

static char *f_render(const Token *t)
{
    switch (t->kind) {
    case TK_STRING: return f_quote(t->text);
    case TK_VARIABLE: return f_wrap("$", t->text, "");
    case TK_FIELD: return f_wrap(".", t->text, "");
    case TK_DOLLAR: return xstrdup("$");
    case TK_VERB: return f_wrap("<", t->text, ">");
    case TK_MAP_REF: return f_wrap("`", t->text, "`");
    case TK_MAP_HEADER: return xstrdup("//map{");
    case TK_FN_HEADER: return xstrdup("//fn{");
    default: return xstrdup(t->text);
    }
}

/* 把长词前缀换回短词引用；返回 0 表示没有命中。 */
static char *f_value_replacement(const char *text, FRev *rev)
{
    int i;
    int tlen = (int)strlen(text);

    for (i = 0; i < rev->len; i++) {
        const char *lw = rev->longs[i];
        int llen;
        if (lw == 0 || lw[0] == 0) continue;
        llen = (int)strlen(lw);
        if (strcmp(text, lw) == 0) return f_wrap("`", rev->shorts[i], "`");
        if (tlen > llen && strncmp(text, lw, (size_t)llen) == 0) {
            unsigned char nxt = (unsigned char)text[llen];
            if (!is_word_byte(nxt) && nxt != '_' && nxt != '-') {
                return f_join(f_wrap("`", rev->shorts[i], "`"), text + llen);
            }
        }
    }
    return 0;
}

/* ------------------------------------------------------------------ */
/* token stream -> units                                               */
/* ------------------------------------------------------------------ */

struct FUnit {
    int is_newline;
    TokKind kind;
    char *text;
    int tight;
};

struct FUnits {
    FUnit *items;
    int len;
    int cap;
};

static void fu_add(FUnits *u, int is_newline, TokKind kind, char *text, int tight)
{
    if (u->len == u->cap) {
        u->cap = u->cap ? u->cap * 2 : 16;
        u->items = (FUnit *)xrealloc(u->items, sizeof(FUnit) * (size_t)u->cap);
    }
    u->items[u->len].is_newline = is_newline;
    u->items[u->len].kind = kind;
    u->items[u->len].text = text;
    u->items[u->len].tight = tight;
    u->len++;
}

/* 展示态：`短词` 后紧跟的裸词/字符串/引用要并回一个长词字符串。 */
static char *f_expand_ref(FEntries *entries, const Token *toks, int n,
                          FLines *fl, int index, int *next)
{
    FEntry *mapped = fe_get(entries, toks[index].text);
    FBuf b;
    int cursor;

    fb_init(&b);
    fb_puts(&b, mapped->long_word);
    cursor = index + 1;
    while (cursor < n && (toks[cursor].kind == TK_BARE ||
                          toks[cursor].kind == TK_STRING ||
                          toks[cursor].kind == TK_MAP_REF)) {
        FEntry *inner;
        if (!f_adjacent(fl, &toks[cursor - 1], &toks[cursor])) break;
        inner = fe_get(entries, toks[cursor].text);
        if (toks[cursor].kind == TK_MAP_REF && inner != 0 &&
            f_value_marker(inner->marker)) {
            fb_puts(&b, inner->long_word);
        } else {
            fb_puts(&b, toks[cursor].text);
        }
        cursor++;
    }
    *next = cursor;
    return f_quote(b.s);
}

static void fu_build(FUnits *u, FEntries *entries, FRev *rev_value,
                     FRev *rev_verb, const Token *toks, int n, FLines *fl,
                     int display)
{
    int i = 0;

    u->items = 0;
    u->len = 0;
    u->cap = 0;
    while (i < n) {
        const Token *t = &toks[i];
        FEntry *mapped;
        char *text = 0;
        int tight;
        int next = i + 1;

        if (t->kind == TK_EOF) break;
        if (t->kind == TK_NEWLINE) {
            fu_add(u, 1, t->kind, 0, 0);
            i++;
            continue;
        }

        tight = i > 0 && toks[i - 1].kind != TK_NEWLINE &&
                f_adjacent(fl, &toks[i - 1], t);
        mapped = fe_get(entries, t->text);

        if (display) {
            if (t->kind == TK_MAP_REF && mapped != 0 &&
                f_value_marker(mapped->marker)) {
                text = f_expand_ref(entries, toks, n, fl, i, &next);
            } else if (t->kind == TK_VERB && mapped != 0 &&
                       mapped->marker[0] == '<') {
                text = f_wrap("<", mapped->long_word, ">");
            }
        } else {
            if (t->kind == TK_BARE || t->kind == TK_STRING) {
                text = f_value_replacement(t->text, rev_value);
            } else if (t->kind == TK_VERB) {
                const char *short_word = fr_get(rev_verb, t->text);
                if (short_word != 0) text = f_wrap("<", short_word, ">");
            }
        }

        if (text == 0) text = f_render(t);
        fu_add(u, 0, t->kind, text, tight);
        i = next;
    }
}

/* ------------------------------------------------------------------ */
/* units -> text                                                       */
/* ------------------------------------------------------------------ */

static int f_merges(const char *left_text, const char *right_text)
{
    int ln = (int)strlen(left_text);
    int rn = (int)strlen(right_text);
    int i;
    unsigned char lb;
    unsigned char rb;

    if (ln == 0 || rn == 0) return 0;
    i = ln - 1;
    while (i > 0 && is_utf8_cont((unsigned char)left_text[i])) i--;
    lb = (unsigned char)left_text[i];
    rb = (unsigned char)right_text[0];
    return (is_word_byte(lb) || in_set("_-.:$", lb)) &&
           (is_word_byte(rb) || in_set("_-.", rb));
}

static int f_display_space(TokKind prev, TokKind cur, int cur_tight)
{
    if (cur_tight) return 0;
    if (prev == TK_LBRACKET || prev == TK_LPAREN || prev == TK_MAP_HEADER ||
        prev == TK_FN_HEADER) {
        return cur != TK_LBRACE;
    }
    if (cur == TK_RBRACKET || cur == TK_RPAREN || cur == TK_COMMA ||
        cur == TK_RBRACE) {
        return 0;
    }
    return 1;
}

static char *f_assemble(FUnits *u, int display)
{
    FBuf out;
    int depth = 0;
    int at_line_start = 0;
    int have_prev = 0;
    FUnit *prev = 0;
    int i;

    fb_init(&out);
    for (i = 0; i < u->len; i++) {
        FUnit *unit = &u->items[i];

        if (unit->is_newline) {
            fb_putc(&out, '\n');
            at_line_start = 1;
            have_prev = 0;
            prev = 0;
            continue;
        }
        if (unit->kind == TK_RBRACE && depth > 0) depth--;
        if (at_line_start && display) {
            int k;
            for (k = 0; k < depth; k++) fb_putn(&out, "  ", 2);
        } else if (have_prev) {
            if (display) {
                if (f_display_space(prev->kind, unit->kind, unit->tight)) {
                    fb_putc(&out, ' ');
                }
            } else if (!unit->tight && f_merges(prev->text, unit->text)) {
                fb_putc(&out, ' ');
            }
        }
        fb_puts(&out, unit->text);
        if (unit->kind == TK_LBRACE) depth++;
        at_line_start = 0;
        prev = unit;
        have_prev = 1;
    }
    while (out.len > 0 && out.s[out.len - 1] == '\n') {
        out.len--;
        out.s[out.len] = 0;
    }
    fb_putc(&out, '\n');
    return out.s;
}

/* ------------------------------------------------------------------ */
/* entry                                                               */
/* ------------------------------------------------------------------ */

/* 首行 shebang 的长度；不是 shebang 返回 -1。 */
static int f_shebang_len(const char *source)
{
    int i = 0;
    if (source == 0 || source[0] != '#' || source[1] != '!') return -1;
    while (source[i] != 0 && source[i] != '\n') i++;
    return i;
}

/* `fmt` 回写时原样保留 shebang：否则格式化后的脚本不再可执行。
   词法层把 shebang 当注释丢掉，只剩下它带来的换行，这里换回去。 */
static char *f_keep_shebang(char *body, const char *source)
{
    FBuf b;
    int sl = f_shebang_len(source);
    const char *rest = body;

    if (sl < 0) return body;
    if (rest[0] == '\n') rest++;
    fb_init(&b);
    fb_putn(&b, source, sl);
    fb_putc(&b, '\n');
    fb_puts(&b, rest);
    free(body);
    return b.s;
}

/* display=0 压缩态，display=1 展示态；返回新分配的文本。 */
pub char *fmt_format(const Token *toks, int ntoks, const char *source, int display)
{
    FEntries entries;
    FRev rev_value;
    FRev rev_verb;
    FUnits units;
    FLines fl;
    int i;

    fl_build(&fl, source);
    fe_build(&entries, toks, ntoks);
    fr_init(&rev_value);
    fr_init(&rev_verb);
    for (i = 0; i < entries.len; i++) {
        FEntry *e = &entries.items[i];
        if (f_value_marker(e->marker)) {
            fr_add(&rev_value, e->long_word, e->short_word);
        } else {
            fr_add(&rev_verb, e->long_word, e->short_word);
        }
    }
    fr_sort_desc(&rev_value);
    fu_build(&units, &entries, &rev_value, &rev_verb, toks, ntoks, &fl, display);
    return f_keep_shebang(f_assemble(&units, display), source);
}
